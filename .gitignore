# BuddySwitch run noise (keep repo skeleton only during rapid iteration)
runs/summaries/**
!runs/summaries/.gitkeep

# BuddySwitch generated state and artifacts
artifacts/**
!artifacts/.gitkeep

# Project runtime noise (keep only skeleton marker)
projects/app/.runtime/**
!projects/app/.runtime/.gitkeep

# Test runner output
test-results/
playwright-report/

# Temporary and local noise
.worktrees/
*.log
*.tmp
*.trace
*.out
*.dump
*.pyc
__pycache__/
tmp/
.DS_Store

# Secrets and local environment
.env
.env.*
!.env.example
