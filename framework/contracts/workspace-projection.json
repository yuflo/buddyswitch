{
  "contract_id": "workspace-projection",
  "contract_version": "2026-04-21",
  "endpoint": "/api/workspace",
  "top_level_key_order": [
    "generated_at",
    "manifest_path",
    "objects_root",
    "buddies",
    "tracks",
    "standalone_tasks",
    "tasks",
    "artifacts",
    "run_audits"
  ],
  "data_sources": [
    "buddyswitch/manifest.toml",
    "buddyswitch/objects/tracks/*.json",
    "buddyswitch/objects/tasks/*.json",
    "buddyswitch/objects/artifacts/*.json",
    "buddyswitch/content/runs/*.json"
  ],
  "read_only": true,
  "no_snapshot_fallback": true,
  "field_constraints": {
    "manifest_path": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/manifest.toml"
    },
    "objects_root": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/objects"
    }
  },
  "view_shapes": {
    "buddy": {
      "key_order": [
        "id",
        "label",
        "scope"
      ],
      "field_types": {
        "id": "string",
        "label": "string",
        "scope": "string"
      }
    },
    "track": {
      "key_order": [
        "id",
        "title",
        "status",
        "current_buddy",
        "next_buddy",
        "task_ids",
        "summary",
        "updated_at",
        "tasks",
        "missing_task_ids"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "status": "string",
        "current_buddy": "string",
        "next_buddy": "string-or-null",
        "task_ids": "string-array",
        "summary": "string",
        "updated_at": "string",
        "tasks": "task-array",
        "missing_task_ids": "string-array"
      }
    },
    "task": {
      "key_order": [
        "id",
        "buddy",
        "title",
        "status",
        "track_id",
        "artifact_ids",
        "artifact_slots",
        "run_ids",
        "latest_run_id",
        "summary",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "current_artifacts",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "buddy": "string",
        "title": "string",
        "status": "string",
        "track_id": "string-or-null",
        "artifact_ids": "string-array",
        "artifact_slots": "artifact-slot-map",
        "run_ids": "string-array",
        "latest_run_id": "string",
        "summary": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "current_artifacts": "artifact-map",
        "missing": "boolean"
      },
      "artifact_slot_entry": {
        "key_order": [
          "current_artifact_id",
          "revision_count"
        ],
        "field_types": {
          "current_artifact_id": "string",
          "revision_count": "integer"
        }
      }
    },
    "artifact": {
      "key_order": [
        "id",
        "title",
        "task_id",
        "buddy",
        "skill_id",
        "slot",
        "revision",
        "supersedes_artifact_id",
        "is_current",
        "source_run_id",
        "summary",
        "content",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "task_id": "string",
        "buddy": "string",
        "skill_id": "string",
        "slot": "string",
        "revision": "integer",
        "supersedes_artifact_id": "string-or-null",
        "is_current": "boolean",
        "source_run_id": "string",
        "summary": "string",
        "content": "object",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "run_audit": {
      "key_order": [
        "run_id",
        "path",
        "buddy",
        "task_id",
        "task_title",
        "demand",
        "skill_id",
        "artifact_ids",
        "track_id",
        "track_title",
        "track_action",
        "execution_summary",
        "reference_switches",
        "related_run_ids",
        "recommended_switch",
        "updated_at",
        "status"
      ],
      "field_types": {
        "run_id": "string",
        "path": "repo-relative-path",
        "buddy": "string-or-null",
        "task_id": "string-or-null",
        "task_title": "string-or-null",
        "demand": "string-or-null",
        "skill_id": "string-or-null",
        "artifact_ids": "string-array",
        "track_id": "string-or-null",
        "track_title": "string-or-null",
        "track_action": "string-or-null",
        "execution_summary": "string-or-null",
        "reference_switches": "string-map",
        "related_run_ids": "string-array",
        "recommended_switch": "string-or-null",
        "updated_at": "string",
        "status": "string"
      }
    },
    "run_audit_invalid": {
      "key_order": [
        "run_id",
        "path",
        "status",
        "updated_at"
      ],
      "field_types": {
        "run_id": "string",
        "path": "repo-relative-path",
        "status": "string",
        "updated_at": "string"
      }
    }
  },
  "derived_invariants": {
    "task_view_slot_field": "current_artifacts",
    "track_view_missing_reference_field": "missing_task_ids",
    "current_artifacts_value_shape": "artifact",
    "tracks_embed_task_views": true
  }
}
