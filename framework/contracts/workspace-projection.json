{
  "contract_id": "workspace-projection",
  "contract_version": "2026-05-18",
  "endpoint": "/api/workspace",
  "top_level_key_order": [
    "generated_at",
    "manifest_path",
    "objects_root",
    "buddies",
    "tracks",
    "standalone_tasks",
    "tasks",
    "artifacts"
  ],
  "data_sources": [
    "buddyswitch/manifest.toml",
    "buddyswitch/objects/tracks/*.json",
    "buddyswitch/objects/tasks/*.json",
    "buddyswitch/objects/artifacts/*.json",
    "buddyswitch/objects/comments/*.json"
  ],
  "read_only": true,
  "no_snapshot_fallback": true,
  "field_constraints": {
    "manifest_path": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/manifest.toml"
    },
    "objects_root": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/objects"
    }
  },
  "view_shapes": {
    "buddy": {
      "key_order": [
        "id",
        "label",
        "scope"
      ],
      "field_types": {
        "id": "string",
        "label": "string",
        "scope": "string"
      }
    },
    "track": {
      "key_order": [
        "id",
        "title",
        "outcome",
        "owner_buddy",
        "state",
        "health",
        "appetite",
        "now",
        "shared_materials",
        "updates",
        "close_proof",
        "created_at",
        "updated_at",
        "archived_at",
        "comment_ids",
        "missing_artifact_ids"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "outcome": "string",
        "owner_buddy": "string",
        "state": "string",
        "health": "string",
        "appetite": "string",
        "now": "object",
        "shared_materials": "object-array",
        "updates": "object-array",
        "close_proof": "object-array",
        "created_at": "string",
        "updated_at": "string",
        "archived_at": "string-or-null",
        "comment_ids": "string-array",
        "missing_artifact_ids": "string-array"
      }
    },
    "task": {
      "key_order": [
        "id",
        "buddy",
        "title",
        "status",
        "track_id",
        "summary",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "buddy": "string",
        "title": "string",
        "status": "string",
        "track_id": "string-or-null",
        "summary": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "artifact": {
      "key_order": [
        "id",
        "title",
        "kind",
        "created_by",
        "published_to_track",
        "publication_role",
        "summary",
        "content",
        "source_refs",
        "revision",
        "supersedes_artifact_id",
        "is_current",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "comment_ids",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "kind": "string",
        "created_by": "string",
        "published_to_track": "string-or-null",
        "publication_role": "string-or-null",
        "summary": "string",
        "content": "object",
        "source_refs": "object-array-or-null",
        "revision": "integer",
        "supersedes_artifact_id": "string-or-null",
        "is_current": "boolean",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "comment_ids": "string-array",
        "missing": "boolean"
      }
    }
  },
  "derived_invariants": {
    "track_page_shape": true,
    "tracks_embed_tasks": false,
    "task_artifact_linkage_removed": true,
    "artifact_publication_uses_track": true,
    "run_fields_removed": true
  }
}
