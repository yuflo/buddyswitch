{
  "contract_id": "workspace-projection",
  "contract_version": "2026-05-15",
  "endpoint": "/api/workspace",
  "top_level_key_order": [
    "generated_at",
    "manifest_path",
    "objects_root",
    "buddies",
    "tracks",
    "standalone_tasks",
    "tasks",
    "artifacts"
  ],
  "data_sources": [
    "buddyswitch/manifest.toml",
    "buddyswitch/objects/tracks/*.json",
    "buddyswitch/objects/tasks/*.json",
    "buddyswitch/objects/artifacts/*.json",
    "buddyswitch/objects/comments/*.json"
  ],
  "read_only": true,
  "no_snapshot_fallback": true,
  "field_constraints": {
    "manifest_path": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/manifest.toml"
    },
    "objects_root": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/objects"
    }
  },
  "view_shapes": {
    "buddy": {
      "key_order": ["id", "label", "scope"],
      "field_types": {
        "id": "string",
        "label": "string",
        "scope": "string"
      }
    },
    "track": {
      "key_order": [
        "id",
        "title",
        "outcome",
        "state",
        "health",
        "owner_buddy",
        "appetite",
        "now",
        "shared_materials",
        "updates",
        "close_proof",
        "comment_ids",
        "updated_at",
        "archived_at",
        "open_comment_count",
        "resolved_comment_count"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "outcome": "string",
        "state": "string",
        "health": "string",
        "owner_buddy": "string",
        "appetite": "string",
        "now": "object",
        "shared_materials": "artifact-summary-array",
        "updates": "object-array",
        "close_proof": "artifact-summary-array",
        "comment_ids": "string-array",
        "updated_at": "string",
        "archived_at": "string-or-null",
        "open_comment_count": "integer",
        "resolved_comment_count": "integer"
      }
    },
    "task": {
      "key_order": [
        "id",
        "buddy",
        "title",
        "status",
        "track_id",
        "summary",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "buddy": "string",
        "title": "string",
        "status": "string",
        "track_id": "string-or-null",
        "summary": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "artifact": {
      "key_order": [
        "id",
        "title",
        "summary",
        "body",
        "template",
        "status",
        "published_to_track",
        "revision",
        "supersedes_artifact_id",
        "is_current",
        "created_by",
        "authors",
        "source_refs",
        "comment_ids",
        "open_comment_count",
        "resolved_comment_count",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "summary": "string",
        "body": "string",
        "template": "string",
        "status": "string",
        "published_to_track": "string-or-null",
        "revision": "integer",
        "supersedes_artifact_id": "string-or-null",
        "is_current": "boolean",
        "created_by": "string",
        "authors": "string-array",
        "source_refs": "object-array-or-null",
        "comment_ids": "string-array",
        "open_comment_count": "integer",
        "resolved_comment_count": "integer",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    }
  },
  "derived_invariants": {
    "track_shared_material_source": "current published artifacts on the track",
    "track_close_proof_source": "published proof references on the track page",
    "task_objects_are_private_execution_state": true,
    "comments_are_derived_not_embedded_in_artifact_body": true,
    "run_fields_removed": true
  }
}
