{
  "contract_id": "workspace-projection",
  "contract_version": "2026-05-15",
  "endpoint": "/api/workspace",
  "top_level_key_order": [
    "generated_at",
    "manifest_path",
    "objects_root",
    "content_root",
    "buddies",
    "tracks",
    "standalone_tasks",
    "tasks",
    "artifacts",
    "handoffs",
    "memories",
    "buddybox_files"
  ],
  "data_sources": [
    "buddyswitch/manifest.toml",
    "buddyswitch/objects/tracks/*.json",
    "buddyswitch/objects/tasks/*.json",
    "buddyswitch/objects/artifacts/*.json",
    "buddyswitch/objects/handoffs/*.json",
    "buddyswitch/objects/memories/*.json",
    "buddyswitch/content/buddybox/**/*"
  ],
  "read_only": true,
  "no_snapshot_fallback": true,
  "field_constraints": {
    "manifest_path": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/manifest.toml"
    },
    "objects_root": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/objects"
    },
    "content_root": {
      "type": "repo-relative-path",
      "exact": "buddyswitch/content"
    }
  },
  "view_shapes": {
    "buddy": {
      "key_order": ["id", "label", "scope"],
      "field_types": {
        "id": "string",
        "label": "string",
        "scope": "string"
      }
    },
    "track": {
      "key_order": [
        "id",
        "title",
        "status",
        "current_buddy",
        "next_buddy",
        "task_ids",
        "summary",
        "updated_at",
        "tasks",
        "missing_task_ids"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "status": "string",
        "current_buddy": "string",
        "next_buddy": "string-or-null",
        "task_ids": "string-array",
        "summary": "string",
        "updated_at": "string",
        "tasks": "task-array",
        "missing_task_ids": "string-array"
      }
    },
    "task": {
      "key_order": [
        "id",
        "buddy",
        "title",
        "status",
        "track_id",
        "artifact_ids",
        "artifact_slots",
        "summary",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "current_artifacts",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "buddy": "string",
        "title": "string",
        "status": "string",
        "track_id": "string-or-null",
        "artifact_ids": "string-array",
        "artifact_slots": "artifact-slot-map",
        "summary": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "current_artifacts": "artifact-map",
        "missing": "boolean"
      },
      "artifact_slot_entry": {
        "key_order": ["current_artifact_id", "revision_count"],
        "field_types": {
          "current_artifact_id": "string",
          "revision_count": "integer"
        }
      }
    },
    "artifact": {
      "key_order": [
        "id",
        "title",
        "task_id",
        "buddy",
        "kind",
        "revision",
        "supersedes_artifact_id",
        "is_current",
        "created_by",
        "source_refs",
        "summary",
        "content",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "title": "string",
        "task_id": "string",
        "buddy": "string",
        "kind": "string",
        "revision": "integer",
        "supersedes_artifact_id": "string-or-null",
        "is_current": "boolean",
        "created_by": "string",
        "source_refs": "object-array-or-null",
        "summary": "string",
        "content": "object",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "handoff": {
      "key_order": [
        "id",
        "source_buddy",
        "target_buddy",
        "track_id",
        "source_task_id",
        "artifact_ids",
        "memory_ids",
        "buddybox_paths",
        "source_refs",
        "reason",
        "context",
        "status",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "source_buddy": "string",
        "target_buddy": "string",
        "track_id": "string",
        "source_task_id": "string-or-null",
        "artifact_ids": "string-array",
        "memory_ids": "string-array",
        "buddybox_paths": "string-array",
        "source_refs": "object-array-or-null",
        "reason": "string",
        "context": "string",
        "status": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "memory": {
      "key_order": [
        "id",
        "buddy",
        "kind",
        "title",
        "summary",
        "content",
        "source_refs",
        "status",
        "created_at",
        "updated_at",
        "object_path",
        "file_name",
        "missing"
      ],
      "field_types": {
        "id": "string",
        "buddy": "string",
        "kind": "string",
        "title": "string",
        "summary": "string",
        "content": "object",
        "source_refs": "object-array-or-null",
        "status": "string",
        "created_at": "string",
        "updated_at": "string",
        "object_path": "repo-relative-path",
        "file_name": "basename",
        "missing": "boolean"
      }
    },
    "buddybox_file": {
      "key_order": ["buddy", "path", "size_bytes", "updated_at", "content_type", "source_ref"],
      "field_types": {
        "buddy": "string",
        "path": "repo-relative-path",
        "size_bytes": "integer",
        "updated_at": "string",
        "content_type": "string",
        "source_ref": "object"
      }
    }
  },
  "derived_invariants": {
    "task_view_slot_field": "current_artifacts",
    "track_view_missing_reference_field": "missing_task_ids",
    "current_artifacts_value_shape": "artifact",
    "tracks_embed_task_views": true,
    "run_fields_removed": true
  }
}
