{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "artifact_content": {
      "type": "object",
      "required": [
        "research_question",
        "research_strategy",
        "channel_plan",
        "iteration_log",
        "evidence",
        "source_traceability",
        "patterns_and_insights",
        "risks_and_caveats",
        "conclusion"
      ],
      "additionalProperties": false,
      "properties": {
        "research_question": { "type": "string" },
        "research_strategy": {
          "type": "object",
          "required": ["complexity_tier", "rationale", "collection_mode", "inclusion_notes"],
          "additionalProperties": false,
          "properties": {
            "complexity_tier": { "type": "string", "enum": ["quick", "standard", "deep"] },
            "rationale": { "type": "string" },
            "collection_mode": { "type": "string" },
            "inclusion_notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "channel_plan": { "type": "array", "items": { "type": "string" } },
        "iteration_log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "round",
              "query_planning",
              "candidate_discovery",
              "browser_evidence_capture",
              "round_synthesis",
              "query_refinement"
            ],
            "additionalProperties": false,
            "properties": {
              "round": { "type": "integer" },
              "query_planning": { "type": "string" },
              "candidate_discovery": { "type": "string" },
              "browser_evidence_capture": { "type": "string" },
              "round_synthesis": { "type": "string" },
              "query_refinement": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "url",
              "source_type",
              "accessed_at",
              "claim_excerpt",
              "page_title",
              "auth_state",
              "query_or_filter_used"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "url": { "type": "string" },
              "source_type": { "type": "string" },
              "accessed_at": { "type": "string" },
              "claim_excerpt": { "type": "string" },
              "page_title": { "type": "string" },
              "auth_state": { "type": "string", "enum": ["public", "logged_in", "paywalled", "unknown"] },
              "query_or_filter_used": { "type": "string" },
              "interaction_steps_summary": { "type": "string" },
              "screenshot_ref_or_snapshot_ref": { "type": "string" }
            }
          }
        },
        "source_traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conclusion", "source_ids"],
            "additionalProperties": false,
            "properties": {
              "conclusion": { "type": "string" },
              "source_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "patterns_and_insights": { "type": "array", "items": { "type": "string" } },
        "risks_and_caveats": { "type": "array", "items": { "type": "string" } },
        "conclusion": { "type": "string" }
      }
    }
  }
}
