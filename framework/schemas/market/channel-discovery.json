{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "artifact_content": {
      "type": "object",
      "required": [
        "research_question",
        "candidate_channels",
        "selection_criteria",
        "channel_scores",
        "recommended_primary_channel",
        "recommended_secondary_channel",
        "experiment_plan",
        "kill_signals",
        "evidence",
        "source_traceability",
        "risks_and_unknowns",
        "conclusion"
      ],
      "additionalProperties": false,
      "properties": {
        "research_question": { "type": "string" },
        "candidate_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "why_it_is_plausible"],
            "additionalProperties": false,
            "properties": {
              "channel": { "type": "string" },
              "why_it_is_plausible": { "type": "string" },
              "constraints": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "selection_criteria": { "type": "array", "items": { "type": "string" } },
        "channel_scores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "scores", "summary"],
            "additionalProperties": false,
            "properties": {
              "channel": { "type": "string" },
              "scores": {
                "type": "object",
                "required": ["reachability", "credibility", "speed", "cost", "signal_quality"],
                "additionalProperties": false,
                "properties": {
                  "reachability": { "type": "integer" },
                  "credibility": { "type": "integer" },
                  "speed": { "type": "integer" },
                  "cost": { "type": "integer" },
                  "signal_quality": { "type": "integer" }
                }
              },
              "summary": { "type": "string" }
            }
          }
        },
        "recommended_primary_channel": {
          "type": "object",
          "required": ["channel", "why", "preconditions"],
          "additionalProperties": false,
          "properties": {
            "channel": { "type": "string" },
            "why": { "type": "string" },
            "preconditions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "recommended_secondary_channel": {
          "type": "object",
          "required": ["channel", "why"],
          "additionalProperties": false,
          "properties": {
            "channel": { "type": "string" },
            "why": { "type": "string" },
            "preconditions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "experiment_plan": {
          "type": "object",
          "required": ["goal", "offer", "audience", "steps", "timebox"],
          "additionalProperties": false,
          "properties": {
            "goal": { "type": "string" },
            "offer": { "type": "string" },
            "audience": { "type": "string" },
            "steps": { "type": "array", "items": { "type": "string" } },
            "timebox": { "type": "string" },
            "success_signal": { "type": "string" }
          }
        },
        "kill_signals": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "url",
              "source_type",
              "accessed_at",
              "claim_excerpt",
              "page_title",
              "auth_state",
              "query_or_filter_used",
              "interaction_steps_summary",
              "screenshot_ref_or_snapshot_ref"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "url": { "type": "string" },
              "source_type": { "type": "string" },
              "accessed_at": { "type": "string" },
              "claim_excerpt": { "type": "string" },
              "page_title": { "type": "string" },
              "auth_state": { "type": "string", "enum": ["public", "logged_in", "paywalled", "unknown"] },
              "query_or_filter_used": { "type": "string" },
              "interaction_steps_summary": { "type": "string" },
              "screenshot_ref_or_snapshot_ref": { "type": "string" }
            }
          }
        },
        "source_traceability": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conclusion", "source_ids"],
            "additionalProperties": false,
            "properties": {
              "conclusion": { "type": "string" },
              "source_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "risks_and_unknowns": { "type": "array", "items": { "type": "string" } },
        "conclusion": { "type": "string" }
      }
    }
  }
}
