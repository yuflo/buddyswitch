          "additionalProperties": false,
          "properties": {
            "initiative_rules": { "type": "array", "items": { "type": "string" } },
            "execution_boundaries": { "type": "array", "items": { "type": "string" } },
            "recovery_paths": { "type": "array", "items": { "type": "string" } }
