      "required": [
        "ia",
        "primary_flows",
        "key_screens",
        "state_coverage",
        "interaction_notes",
        "open_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "ia": { "type": "array", "items": { "type": "string" } },
        "primary_flows": { "type": "array", "items": { "type": "string" } },
        "key_screens": { "type": "array", "items": { "type": "string" } },
        "state_coverage": {
          "type": "object",
