{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "artifact_content": {
      "type": "object",
      "required": [
        "prototype_kind",
        "page_map",
        "primary_user_flow",
        "preview",
        "handoff",
        "open_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "prototype_kind": { "type": "string" },
        "page_map": { "type": "array", "items": { "type": "string" } },
        "primary_user_flow": { "type": "array", "items": { "type": "string" } },
        "preview": {
          "type": "object",
          "required": ["sandbox_root", "entry_file"],
          "additionalProperties": false,
          "properties": {
            "sandbox_root": { "type": "string" },
            "entry_file": { "type": "string" }
          }
        },
        "handoff": {
          "type": "object",
          "required": ["pm", "dev", "test"],
          "additionalProperties": false,
          "properties": {
            "pm": { "type": "array", "items": { "type": "string" } },
            "dev": { "type": "array", "items": { "type": "string" } },
            "test": { "type": "array", "items": { "type": "string" } }
          }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
