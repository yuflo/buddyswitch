{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "artifact_content": {
      "type": "object",
      "required": [
        "test_scope",
        "passed_items",
        "failed_items",
        "blocked_items",
        "reproduction_steps",
        "overall_readiness_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "test_scope": { "type": "string" },
        "passed_items": { "type": "array", "items": { "type": "string" } },
        "failed_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case", "observed", "expected"],
            "additionalProperties": false,
            "properties": {
              "case": { "type": "string" },
              "observed": { "type": "string" },
              "expected": { "type": "string" }
            }
          }
        },
        "blocked_items": { "type": "array", "items": { "type": "string" } },
        "reproduction_steps": { "type": "array", "items": { "type": "string" } },
        "overall_readiness_summary": { "type": "string" }
      }
    }
  }
}
