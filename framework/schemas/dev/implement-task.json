{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "artifact_content": {
      "type": "object",
      "required": [
        "task_summary",
        "changed_files",
        "implementation_notes",
        "verification_runs",
        "known_limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "task_summary": { "type": "string" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "implementation_notes": { "type": "array", "items": { "type": "string" } },
        "verification_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "result", "notes"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "result": { "type": "string" },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "known_limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
