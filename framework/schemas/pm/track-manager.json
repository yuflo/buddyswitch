{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "track_operation"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_summary": { "type": "string" },
    "working_notes": { "type": "array", "items": { "type": "string" } },
    "deliverables_or_changed_files": { "type": "array", "items": { "type": "string" } },
    "track_operation": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["create", "update", "advance", "archive"]
        },
        "track_id": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"], "enum": ["active", "blocked", "done", "archived", null] },
        "current_buddy": { "type": ["string", "null"] },
        "next_buddy": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] }
      }
    }
  }
}
