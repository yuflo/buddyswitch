{
  "type": "object",
  "required": [
    "execution_summary",
    "working_notes",
    "deliverables_or_changed_files",
    "artifact_content"
  ],
  "properties": {
    "execution_summary": {"type": "string"},
    "working_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deliverables_or_changed_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifact_content": {
      "type": "object",
      "required": [
        "summary",
        "decisions",
        "risks",
        "open_questions",
        "suggested_next_step",
        "specialized_sections"
      ],
      "properties": {
        "summary": {"type": "string"},
        "decisions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "risks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "open_questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "suggested_next_step": {"type": "string"},
        "specialized_sections": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "state_effects": {
      "type": "object",
      "properties": {
        "track_operation": {
          "type": "object",
          "required": ["action"],
          "properties": {
            "action": {
              "type": "string",
              "enum": ["create", "update", "advance", "archive"]
            },
            "track_id": {"type": ["string", "null"]},
            "title": {"type": ["string", "null"]},
            "status": {
              "type": ["string", "null"],
              "enum": ["active", "blocked", "done", "archived", null]
            },
            "current_buddy": {"type": ["string", "null"]},
            "next_buddy": {"type": ["string", "null"]},
            "summary": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
