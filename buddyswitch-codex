#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
ENV_HELPER="${REPO_ROOT}/tools/launcher/env.sh"
WORKSPACE_HELPER="${REPO_ROOT}/tools/launcher/workspace.sh"
BROWSER_HELPER="${REPO_ROOT}/tools/launcher/browser_cockpit.sh"
APP_SERVER_HELPER="${REPO_ROOT}/tools/launcher/app_server.sh"
INSTANCE_HELPER="${REPO_ROOT}/tools/launcher/instance.sh"
CLEANUP_HELPER="${REPO_ROOT}/tools/launcher/cleanup.sh"
RUNTIME_BROKER_HELPER="${REPO_ROOT}/tools/launcher/runtime_broker.sh"

if [[ ! -f "${ENV_HELPER}" || ! -f "${WORKSPACE_HELPER}" || ! -f "${BROWSER_HELPER}" || ! -f "${APP_SERVER_HELPER}" || ! -f "${INSTANCE_HELPER}" || ! -f "${CLEANUP_HELPER}" || ! -f "${RUNTIME_BROKER_HELPER}" ]]; then
  echo "Launcher helpers are missing under tools/launcher." >&2
  exit 1
fi

source "${ENV_HELPER}"
source "${WORKSPACE_HELPER}"
source "${BROWSER_HELPER}"
source "${APP_SERVER_HELPER}"
source "${INSTANCE_HELPER}"
source "${CLEANUP_HELPER}"
source "${RUNTIME_BROKER_HELPER}"

buddyswitch_env_init

print_help() {
  cat <<EOF
Usage:
  buddyswitch-codex instance buddies
  buddyswitch-codex instance start --buddy <buddy>
  buddyswitch-codex instance input <instance-id> --text <text>
  buddyswitch-codex instance attach <instance-id>
  buddyswitch-codex instance stop <instance-id>
  buddyswitch-codex instance status <instance-id> [--json]
  buddyswitch-codex instance interrupt <instance-id>
  buddyswitch-codex instance list [--buddy <buddy>]
  buddyswitch-codex instance delete <instance-id> [--yes]

  buddyswitch-codex data cleanup --buddy <buddy> [--yes] [--json]
  buddyswitch-codex data cleanup --all-data [--yes] [--json]

  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <instance-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <instance-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env reset [--yes]

  buddyswitch-codex help

Commands:
  instance Manage BuddySwitch product-mode instances.
  data     Manage BuddySwitch data cleanup commands.
  env      Manage BuddySwitch environment status and reset commands.
  help     Show this help message.

Environment:
  BUDDYSWITCH_SHARED_ROOT      Shared launcher root (default: ${BUDDYSWITCH_SHARED_ROOT})
  BUDDYSWITCH_SOURCE_HOME      Source HOME for bootstrap (default: current HOME)
  BUDDYSWITCH_SOURCE_CODEX_HOME
                               Source CODEX_HOME for auth bootstrap
  BUDDYSWITCH_BROWSER_PORT     Browser cockpit port (default: ${BUDDYSWITCH_BROWSER_PORT:-9222})
  BUDDYSWITCH_BROWSER_PROFILE_DIR
                               Browser profile dir (default: ${BUDDYSWITCH_BROWSER_PROFILE_DIR:-<instance>/browser/profile})
  BUDDYSWITCH_BROWSER_LOG_FILE Browser Chrome log file (default: ${BUDDYSWITCH_BROWSER_LOG_FILE:-<instance>/browser/chrome.log})

Paths:
  shared root: ${BUDDYSWITCH_SHARED_ROOT}
  home: ${BUDDYSWITCH_HOME}
  codex home: ${BUDDYSWITCH_CODEX_HOME}
EOF
}

start_codex() {
  local buddy instance_id instance_json

  buddy=""
  instance_id=""
  instance_json=""
  if [[ $# -eq 0 ]]; then
    echo "instance start requires --buddy <buddy>" >&2
    print_help >&2
    return 2
  fi

  case "${1}" in
    --buddy)
      if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
        echo "Missing value for --buddy" >&2
        print_help >&2
        return 2
      fi
      buddy="${2}"
      shift 2
      ;;
    --buddy=*)
      buddy="${1#--buddy=}"
      if [[ -z "${buddy}" ]]; then
        echo "Missing value for --buddy" >&2
        print_help >&2
        return 2
      fi
      shift
      ;;
    *)
      echo "instance start requires --buddy <buddy>" >&2
      print_help >&2
      return 2
      ;;
  esac

  if [[ $# -gt 0 ]]; then
    echo "instance start no longer accepts Codex args; use instance input after the service starts." >&2
    return 2
  fi

  buddyswitch_validate_buddy_id "${buddy}" || return $?
  instance_id="$(buddyswitch_generate_instance_id "${buddy}")"
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  instance_json="$(buddyswitch_instance_json_path "${instance_id}")"

  (
    unset BUDDYSWITCH_ACTIVE_BUDDY
    unset BUDDYSWITCH_INSTANCE_ID
    unset BUDDYSWITCH_INSTANCE_JSON
    BUDDYSWITCH_START_BUDDY="${buddy}" \
    BUDDYSWITCH_START_INSTANCE_ID="${instance_id}" \
      buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-start-bootstrap"
  )

  echo "BuddySwitch instance: ${instance_id} (${buddy})"
  echo "Workspace: ${BUDDYSWITCH_WORKSPACE_DIR}"
  echo "Project workspace: ${BUDDYSWITCH_PROJECT_WORKSPACE_DIR}"
  echo "Instance record: ${instance_json}"
  echo "Input: ./buddyswitch-codex instance input ${instance_id} --text \"<text>\""
  echo "Attach: ./buddyswitch-codex instance attach ${instance_id}"
  echo "Stop: ./buddyswitch-codex instance stop ${instance_id}"
  echo "Delete instance: ./buddyswitch-codex instance delete ${instance_id} --yes"
}

start_locked_bootstrap() {
  local requested_buddy requested_instance_id app_server_json thread_json thread_id
  buddyswitch_require_runtime_lock
  requested_buddy="${BUDDYSWITCH_START_BUDDY:-}"
  requested_instance_id="${BUDDYSWITCH_START_INSTANCE_ID:-}"

  if [[ -z "${requested_buddy}" ]]; then
    echo "BUDDYSWITCH_START_BUDDY is required for product instance bootstrap." >&2
    return 2
  fi
  if [[ -z "${requested_instance_id}" ]]; then
    echo "BUDDYSWITCH_START_INSTANCE_ID is required for product instance bootstrap." >&2
    return 2
  fi
  buddyswitch_validate_buddy_id "${requested_buddy}" || return $?
  buddyswitch_validate_instance_id "${requested_instance_id}" || return $?
  buddyswitch_require_env_profile "${requested_buddy}" || return $?
  buddyswitch_require_buddy_agents_template "${requested_buddy}" || return $?
  buddyswitch_env_bind_instance "${requested_instance_id}" || return $?
  buddyswitch_browser_allocate_instance_port

  buddyswitch_ensure_shared_env
  buddyswitch_workspace_prepare_execution_worktree

  buddyswitch_workspace_ensure_project_worktree
  buddyswitch_workspace_repair_runtime_projects_app_projection
  buddyswitch_instance_activate "${requested_instance_id}" "${requested_buddy}" "inactive" >/dev/null
  buddyswitch_runtime_broker_ensure
  buddyswitch_patch_codex_config
  if ! buddyswitch_browser_bootstrap; then
    buddyswitch_runtime_broker_stop
    return 1
  fi
  buddyswitch_instance_set_browser_port "${requested_instance_id}" "${BUDDYSWITCH_BROWSER_PORT}"
  app_server_json="$(buddyswitch_app_server_ensure)" || {
    buddyswitch_runtime_broker_stop
    buddyswitch_browser_instance_stop "${requested_instance_id}" || true
    return 1
  }
  thread_json="$(buddyswitch_app_server_thread_start)" || {
    buddyswitch_app_server_stop || true
    buddyswitch_runtime_broker_stop
    buddyswitch_browser_instance_stop "${requested_instance_id}" || true
    return 1
  }
  thread_id="$(
    python3 - "${thread_json}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
thread = payload.get("thread")
if isinstance(thread, dict):
    thread_id = thread.get("id")
    if isinstance(thread_id, str):
        print(thread_id)
PY
  )"
  if [[ -z "${thread_id}" ]]; then
    echo "App-server thread start did not return thread.id." >&2
    echo "${thread_json}" >&2
    buddyswitch_app_server_stop || true
    buddyswitch_runtime_broker_stop
    buddyswitch_browser_instance_stop "${requested_instance_id}" || true
    return 1
  fi
  buddyswitch_instance_set_app_server \
    "${requested_instance_id}" \
    "${thread_id}" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "pid")" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "socket_path")" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "log_file")" \
    "active"
}

instance_set_inactive_locked() {
  local instance_id="${1:-}"
  buddyswitch_require_runtime_lock
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  buddyswitch_app_server_stop || true
  buddyswitch_runtime_broker_stop
  buddyswitch_browser_instance_stop "${instance_id}" || true
  buddyswitch_instance_clear_app_server "${instance_id}" "inactive"
}

instance_input() {
  local instance_id="${1:-}" text="" thread_id="" arg output action turn_id
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --text)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance input requires --text <text>" >&2
          return 2
        fi
        text="$2"
        shift 2
        ;;
      *)
        echo "Unknown instance input option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${text}" ]]; then
    echo "instance input requires --text <text>" >&2
    return 2
  fi

  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${instance_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance input blocked: ${instance_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance input blocked: ${instance_id} is unhealthy or inactive." >&2
    return 3
  fi

  output="$(buddyswitch_app_server_input "${thread_id}" "${text}" 2>&1)" || {
    if [[ "${output}" == *"turn/steer failed"* ]]; then
      echo "Instance input blocked: active turn is not steerable; retry later or interrupt it." >&2
      echo "${output}" >&2
      return 1
    fi
    if [[ -n "${output}" ]]; then
      echo "${output}" >&2
    fi
    return 1
  }

  action="$(
    python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get("action")
if isinstance(value, str):
    print(value)
PY
  )"
  turn_id="$(
    python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get("turn_id")
if isinstance(value, str):
    print(value)
PY
  )"
  if [[ "${action}" == "steer" ]]; then
    echo "Steered turn: ${turn_id}"
  else
    echo "Started turn: ${turn_id}"
  fi
}

instance_attach() {
  local instance_id="${1:-}" buddy thread_id socket_path
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true
  if [[ $# -gt 0 ]]; then
    echo "Unknown instance attach option: $1" >&2
    return 2
  fi

  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddy="$(buddyswitch_instance_validate_record "${instance_id}")" || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${instance_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance attach blocked: ${instance_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance attach blocked: ${instance_id} is unhealthy or inactive." >&2
    return 3
  fi

  socket_path="$(buddyswitch_instance_record_field "${instance_id}" "app_server_socket" || true)"
  if [[ -z "${socket_path}" ]]; then
    socket_path="$(buddyswitch_app_server_socket)"
  fi

  cd "${BUDDYSWITCH_WORKSPACE_DIR}"
  BUDDYSWITCH_ACTIVE_BUDDY="${buddy}" \
  BUDDYSWITCH_INSTANCE_ID="${instance_id}" \
  BUDDYSWITCH_INSTANCE_JSON="${BUDDYSWITCH_INSTANCE_JSON}" \
    buddyswitch_run_codex resume --remote "unix://${socket_path}" "${thread_id}"
}

instance_stop() {
  local instance_id="${1:-}"
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true
  if [[ $# -gt 0 ]]; then
    echo "Unknown instance stop option: $1" >&2
    return 2
  fi

  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?

  buddyswitch_with_runtime_lock \
    "${REPO_ROOT}/buddyswitch-codex" \
    "__locked-instance-set-inactive" \
    "${instance_id}"
  echo "Instance stopped: ${instance_id}"
}

instance_status_json() {
  local instance_id="$1" app_status_json thread_id thread_json=""
  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${instance_id}" "thread_id" || true)"
  app_status_json="$(buddyswitch_app_server_status_json 2>/dev/null || true)"
  if [[ -z "${app_status_json}" ]]; then
    app_status_json='{"healthy": false, "pid": null, "pid_live": false, "socket_path": "", "socket_exists": false, "probe": null}'
  fi
  if [[ -n "${thread_id}" ]]; then
    if python3 - "${app_status_json}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
raise SystemExit(0 if payload.get("healthy") else 1)
PY
    then
      thread_json="$(buddyswitch_app_server_thread_read "${thread_id}" 2>/dev/null || true)"
    fi
  fi
  python3 - "${BUDDYSWITCH_INSTANCE_JSON}" "${app_status_json}" "${thread_json}" <<'PY'
import json
import sys
from pathlib import Path

instance_payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
app_server = json.loads(sys.argv[2]) if sys.argv[2] else {}
thread_payload = json.loads(sys.argv[3]) if sys.argv[3] else {}

thread = thread_payload.get("thread") if isinstance(thread_payload, dict) else None
thread_status = None
if isinstance(thread, dict):
    raw_status = thread.get("status")
    if isinstance(raw_status, str):
        thread_status = raw_status.lower()
    elif isinstance(raw_status, dict):
        status_type = raw_status.get("type")
        if isinstance(status_type, str):
            thread_status = status_type.lower()

payload = {
    "instance_id": instance_payload.get("instance_id"),
    "buddy": instance_payload.get("buddy"),
    "status": instance_payload.get("status"),
    "workspace_dir": instance_payload.get("workspace_dir"),
    "browser_port": instance_payload.get("browser_port"),
    "updated_at": instance_payload.get("updated_at"),
    "thread_id": instance_payload.get("thread_id"),
    "app_server": app_server,
    "thread": {
        "status": thread_status,
        "raw": thread,
    },
}
print(json.dumps(payload, ensure_ascii=True))
PY
}

instance_status() {
  local instance_id="${1:-}" json=0 payload="" arg
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance status option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  payload="$(instance_status_json "${instance_id}")" || return $?
  if [[ "${json}" -eq 1 ]]; then
    printf '%s\n' "${payload}"
    return 0
  fi

  python3 - "${payload}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
app_server = payload.get("app_server") if isinstance(payload.get("app_server"), dict) else {}
thread = payload.get("thread") if isinstance(payload.get("thread"), dict) else {}

print(f"Instance: {payload.get('instance_id')}")
print(f"Buddy: {payload.get('buddy')}")
print(f"Status: {payload.get('status')}")
print(f"App-server health: {'healthy' if app_server.get('healthy') else 'unhealthy'}")
print(f"Thread id: {payload.get('thread_id') or ''}")
print(f"Thread status: {thread.get('status') or ''}")
print(f"Browser port: {payload.get('browser_port') or ''}")
print(f"Workspace: {payload.get('workspace_dir') or ''}")
print(f"Updated: {payload.get('updated_at') or ''}")
PY
}

instance_interrupt() {
  local instance_id="${1:-}" thread_id output
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true
  if [[ $# -gt 0 ]]; then
    echo "Unknown instance interrupt option: $1" >&2
    return 2
  fi

  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${instance_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance interrupt blocked: ${instance_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance interrupt blocked: ${instance_id} is unhealthy or inactive." >&2
    return 3
  fi

  output="$(buddyswitch_app_server_interrupt "${thread_id}" 2>&1)" || {
    if [[ -n "${output}" ]]; then
      echo "${output}" >&2
    fi
    return 1
  }

  python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
turn_id = payload.get("turn_id")
print(f"Interrupted turn: {turn_id or ''}")
PY
}

instance_delete() {
  local instance_id="${1:-}" confirmed=0 arg
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  shift || true
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      *)
        echo "Unknown instance delete option: ${arg}" >&2
        buddyswitch_instance_usage >&2
        return 2
        ;;
    esac
  done

  buddyswitch_validate_instance_id "${instance_id}" || return $?
  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch instance delete preview"
    echo "Instance: ${instance_id}"
    echo "Instance root: $(buddyswitch_instance_root "${instance_id}")"
    echo "Shared state kept: ${BUDDYSWITCH_SHARED_ROOT}/state"
    echo "Run with --yes to delete this instance root."
    return 0
  fi

  BUDDYSWITCH_DELETE_INSTANCE_ID="${instance_id}" \
    buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-instance-delete"
}

instance_delete_locked() {
  local instance_id instance_root
  buddyswitch_require_runtime_lock
  instance_id="${BUDDYSWITCH_DELETE_INSTANCE_ID:-}"
  if [[ -z "${instance_id}" ]]; then
    echo "instance id is required" >&2
    return 2
  fi
  buddyswitch_validate_instance_id "${instance_id}" || return $?
  buddyswitch_env_bind_instance "${instance_id}" || return $?
  instance_root="$(buddyswitch_instance_require_safe_delete_root "${instance_id}")" || return $?
  buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?

  if buddyswitch_instance_app_server_is_active "${instance_id}"; then
    echo "Instance delete blocked: ${instance_id} is active." >&2
    return 3
  fi
  if buddyswitch_browser_instance_pid_marker_is_active "${instance_id}"; then
    echo "Instance delete blocked: active browser cockpit detected for ${instance_id}." >&2
    return 3
  fi
  if buddyswitch_browser_instance_endpoint_is_active "${instance_id}"; then
    echo "Instance delete blocked: active browser cockpit detected for ${instance_id}." >&2
    return 3
  fi

  buddyswitch_runtime_broker_stop
  buddyswitch_workspace_remove_registered_worktrees_under_strict "${instance_root}" || return $?
  buddyswitch_workspace_force_remove_path "${instance_root}"
  echo "Instance deleted: ${instance_id}"
}

browser_ensure_locked() {
  local instance_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}" browser_port
  buddyswitch_require_runtime_lock
  if [[ -n "${instance_id}" ]]; then
    buddyswitch_validate_instance_id "${instance_id}" || return $?
    buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${instance_id}" || return $?
    browser_port="$(buddyswitch_instance_record_field "${instance_id}" "browser_port" || true)"
    if [[ -n "${browser_port}" ]]; then
      export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
    fi
    buddyswitch_browser_init_defaults
  fi
  buddyswitch_browser_main ensure "$@"
  if [[ -n "${instance_id}" ]]; then
    buddyswitch_instance_set_browser_port "${instance_id}" "${BUDDYSWITCH_BROWSER_PORT}"
  fi
}

validate_reset_request() {
  local confirmed=0
  local arg=""
  for arg in "$@"; do
    if [[ "${arg}" == "--yes" ]]; then
      confirmed=1
    else
      echo "Unknown reset option: ${arg}" >&2
      echo "Use: buddyswitch-codex env reset --yes" >&2
      return 2
    fi
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "Reset requires explicit confirmation." >&2
    echo "Run: buddyswitch-codex env reset --yes" >&2
    return 1
  fi

  if ! buddyswitch_validate_reset_root; then
    return 2
  fi
}

reset_shared_env() {
  validate_reset_request "$@" || return $?
  buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-reset" "$@"
}

reset_shared_env_locked() {
  local active_count
  buddyswitch_require_runtime_lock
  validate_reset_request "$@" || return $?
  active_count="$(buddyswitch_count_active_app_servers)"
  if [[ "${active_count}" -gt 0 ]]; then
    echo "Reset blocked: ${active_count} active buddyswitch-codex instance(s) detected." >&2
    echo "Close active launcher sessions and retry." >&2
    return 3
  fi

  if buddyswitch_browser_is_active; then
    echo "Reset blocked: active browser cockpit detected." >&2
    echo "Stop the browser cockpit and retry." >&2
    return 3
  fi

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}" ]]; then
    buddyswitch_workspace_remove_registered_worktrees_under "${BUDDYSWITCH_SHARED_ROOT}"
    buddyswitch_workspace_force_remove_path "${BUDDYSWITCH_SHARED_ROOT}"
    echo "Reset complete: removed ${BUDDYSWITCH_SHARED_ROOT}"
  else
    echo "Nothing to reset: ${BUDDYSWITCH_SHARED_ROOT} does not exist"
  fi
}

data_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex data cleanup --buddy <buddy> [--yes] [--json]
  buddyswitch-codex data cleanup --all-data [--yes] [--json]
EOF
}

data_main() {
  local command="${1:-}"
  case "${command}" in
    cleanup)
      shift || true
      buddyswitch_cleanup_main "$@"
      ;;
    help|-h|--help|"")
      data_usage
      ;;
    *)
      echo "Unknown data command: ${command}" >&2
      data_usage >&2
      return 2
      ;;
  esac
}

env_status() {
  local json=0 arg instance_count=0 browser_state="inactive"
  for arg in "$@"; do
    case "${arg}" in
      --json)
        json=1
        ;;
      *)
        echo "Unknown env status option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}/instances" ]]; then
    instance_count="$(find "${BUDDYSWITCH_SHARED_ROOT}/instances" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  if buddyswitch_browser_is_active; then
    browser_state="active"
  fi

  if [[ "${json}" -eq 1 ]]; then
    python3 - "${BUDDYSWITCH_SHARED_ROOT}" "${instance_count}" "${browser_state}" <<'PY'
import json
import sys

print(json.dumps({
    "shared_root": sys.argv[1],
    "instance_count": int(sys.argv[2]),
    "browser_state": sys.argv[3],
}, ensure_ascii=True))
PY
    return 0
  fi

  echo "BuddySwitch env status"
  echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
  echo "Instances: ${instance_count}"
  echo "Browser: ${browser_state}"
  echo "Next: ./buddyswitch-codex instance list"
}

env_reset() {
  local confirmed=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      *)
        echo "Unknown env reset option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch env reset preview"
    echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
    echo "Run with --yes to remove the shared BuddySwitch environment."
    return 0
  fi
  reset_shared_env "$@"
}

env_browser_validate_options() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --port)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --port" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        buddyswitch_browser_validate_port_option "$2" || return $?
        shift 2
        ;;
      --profile-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --profile-dir" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        shift 2
        ;;
      --help|-h)
        buddyswitch_browser_usage
        return 0
        ;;
      *)
        echo "Unknown browser option: ${arg}" >&2
        buddyswitch_browser_usage >&2
        return 2
        ;;
    esac
  done
}

env_browser_main() {
  local command="${1:-}" instance_id="" browser_port
  local explicit_port_requested=0 arg
  local -a browser_args=()
  if [[ -n "${command}" ]]; then
    shift || true
  fi

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --instance)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --instance" >&2
          env_usage >&2
          return 2
        fi
        instance_id="${2}"
        shift 2
        ;;
      *)
        browser_args+=("${1}")
        shift
        ;;
    esac
  done

  if [[ -n "${instance_id}" && "${command}" != "ensure" ]]; then
    buddyswitch_validate_instance_id "${instance_id}" || return $?
    buddyswitch_instance_validate_record "${instance_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${instance_id}" || return $?
    browser_port="$(buddyswitch_instance_record_field "${instance_id}" "browser_port" || true)"
    if [[ -n "${browser_port}" ]]; then
      export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
    fi
    buddyswitch_browser_init_defaults
  fi

  case "${command}" in
    status)
      if [[ -z "${instance_id}" ]]; then
        export BUDDYSWITCH_BROWSER_PROFILE_DIR="${BUDDYSWITCH_RUN_STATE_DIR}/browser-status-profile"
        export BUDDYSWITCH_BROWSER_PROFILE_DIR_EXPLICIT=1
        export BUDDYSWITCH_BROWSER_LOG_FILE="${BUDDYSWITCH_RUN_STATE_DIR}/chrome-cockpit.log"
        export BUDDYSWITCH_BROWSER_LOG_FILE_EXPLICIT=1
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        buddyswitch_browser_main status "${browser_args[@]}"
      else
        buddyswitch_browser_main status
      fi
      ;;
    ensure)
      if [[ -z "${instance_id}" ]]; then
        echo "env browser ensure requires --instance <instance-id>" >&2
        env_usage >&2
        return 2
      fi
      buddyswitch_validate_instance_id "${instance_id}" || return $?
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        env_browser_validate_options "${browser_args[@]}" || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        for arg in "${browser_args[@]}"; do
          if [[ "${arg}" == "--port" ]]; then
            explicit_port_requested=1
            break
          fi
        done
      fi
      if [[ "${explicit_port_requested}" -ne 1 ]]; then
        buddyswitch_browser_validate_env_or_default_port || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${instance_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure" "${browser_args[@]}"
      else
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${instance_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure"
      fi
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "Unknown env browser command: ${command}" >&2
      env_usage >&2
      return 2
      ;;
  esac
}

env_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <instance-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <instance-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env reset [--yes]
EOF
}

env_main() {
  local command="${1:-}"
  case "${command}" in
    status)
      shift || true
      env_status "$@"
      ;;
    browser)
      shift || true
      env_browser_main "$@"
      ;;
    reset)
      shift || true
      env_reset "$@"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "env command is not available yet in this task stage." >&2
      env_usage >&2
      return 2
      ;;
  esac
}

legacy_command_hint() {
  local command="${1:-}"
  case "${command}" in
    start)
      echo "buddyswitch-codex instance start --buddy <buddy>"
      ;;
    buddy)
      echo "buddyswitch-codex instance buddies"
      ;;
    cleanup)
      echo "buddyswitch-codex data cleanup ..."
      ;;
    reset)
      echo "buddyswitch-codex env reset --yes"
      ;;
    browser)
      echo "buddyswitch-codex env browser status|ensure ..."
      ;;
    workspace)
      echo "No public replacement. Use instance lifecycle commands."
      ;;
    *)
      echo "buddyswitch-codex help"
      ;;
  esac
}

fail_removed_public_command() {
  local command="${1:-}"
  local hint
  hint="$(legacy_command_hint "${command}")"
  echo "Top-level command removed: ${command}" >&2
  echo "Use: ${hint}" >&2
  return 2
}

fail_unknown_top_level_command() {
  local command="${1:-}"
  echo "Unknown top-level command: ${command}" >&2
  echo "Run: buddyswitch-codex help" >&2
  return 2
}

main() {
  local command="${1:-}"
  case "${command}" in
    __locked-start-bootstrap)
      shift || true
      start_locked_bootstrap "$@"
      ;;
    __locked-reset)
      shift || true
      reset_shared_env_locked "$@"
      ;;
    __locked-browser-ensure)
      shift || true
      browser_ensure_locked "$@"
      ;;
    __locked-instance-set-inactive)
      shift || true
      instance_set_inactive_locked "$@"
      ;;
    __locked-instance-delete)
      shift || true
      instance_delete_locked "$@"
      ;;
    __locked-cleanup)
      shift || true
      buddyswitch_cleanup_run_locked "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    instance)
      shift || true
      buddyswitch_instance_main "$@"
      ;;
    data)
      shift || true
      data_main "$@"
      ;;
    env)
      shift || true
      env_main "$@"
      ;;
    start|buddy|cleanup|reset|browser|workspace)
      fail_removed_public_command "${command}"
      ;;
    "")
      echo "Missing BuddySwitch command." >&2
      echo "Run: buddyswitch-codex help" >&2
      return 2
      ;;
    *)
      fail_unknown_top_level_command "${command}"
      ;;
  esac
}

main "$@"
