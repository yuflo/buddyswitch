  local command="${1:-}"
  case "${command}" in
    cleanup)
      shift || true
      buddyswitch_cleanup_main "$@"
      ;;
    help|-h|--help|"")
      data_usage
      ;;
    *)
      echo "Unknown data command: ${command}" >&2
      data_usage >&2
      return 2
      ;;
