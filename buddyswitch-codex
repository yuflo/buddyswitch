instance_side() {
  local actor_id="${1:-}" text="" side_thread_id="" parent_thread_id="" capability="" arg output json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --text)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side requires --text <text>" >&2
          return 2
        fi
        text="$2"
        shift 2
        ;;
      --side-thread-id)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side requires --side-thread-id <side-thread-id>" >&2
          return 2
        fi
        side_thread_id="$2"
        shift 2
        ;;
      --capability)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side requires --capability <level>" >&2
          return 2
        fi
        capability="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance side option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${text}" ]]; then
    echo "instance side requires --text <text>" >&2
    return 2
  fi
  if [[ -n "${side_thread_id}" && -n "${capability}" ]]; then
    echo "instance side --capability only applies when starting a new side thread" >&2
    return 2
  fi

  instance_require_active_service_thread "${actor_id}" "side" || return $?
  parent_thread_id="${INSTANCE_ACTIVE_THREAD_ID}"

  if [[ -n "${side_thread_id}" ]]; then
    output="$(buddyswitch_side_thread_lifecycle_send "${actor_id}" "${parent_thread_id}" "${side_thread_id}" "${text}" 2>&1)" || {
      if [[ "${output}" == *"turn/steer failed"* ]]; then
        echo "Instance side blocked: active turn is not steerable; retry later or close it." >&2
        echo "${output}" >&2
        return 1
      fi
      [[ -n "${output}" ]] && echo "${output}" >&2
      return 1
    }
    instance_side_print_send_result "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" "${json}"
    return $?
  fi

  output="$(buddyswitch_actor_side_thread_start "${actor_id}" "${parent_thread_id}" "${text}" "${capability}" 2>&1)" || {
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
  }
  side_thread_id="$(
    "${BUDDYSWITCH_PYTHON}" - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get("side_thread_id")
if isinstance(value, str):
    print(value)
PY
  )"
  if [[ -z "${side_thread_id}" ]]; then
    echo "Side start returned no side_thread_id." >&2
    return 1
  fi
  instance_side_print_start_result "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" "${json}"
}


instance_side_cleanup() {
  local actor_id="${1:-}" side_thread_id="" parent_thread_id="" arg output json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --side-thread-id)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side close requires --side-thread-id <side-thread-id>" >&2
          return 2
        fi
        side_thread_id="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance side close option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${side_thread_id}" ]]; then
    echo "instance side close requires --side-thread-id <side-thread-id>" >&2
    return 2
  fi

  instance_require_active_service_thread "${actor_id}" "side close" || return $?
  parent_thread_id="${INSTANCE_ACTIVE_THREAD_ID}"

  output="$(buddyswitch_side_thread_lifecycle_cleanup "${actor_id}" "${parent_thread_id}" "${side_thread_id}" 2>&1)" || {
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
  }

  if [[ "${json}" -eq 1 ]]; then
    "${BUDDYSWITCH_PYTHON}" - "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
payload = {
    "actor_id": sys.argv[2],
    "parent_thread_id": sys.argv[3],
    "side_thread_id": sys.argv[4],
    "action": "close",
}
for key in (
    "turn_id",
    "turn_interrupt_attempted",
    "turn_interrupt_ok",
    "turn_interrupt_error",
    "lease_unregistered",
    "lease_unregister_error",
):
    value = source.get(key)
    if value is not None:
        payload[key] = value
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi
  echo "Side conversation closed: ${side_thread_id}"
}

instance_goal_print_json() {
  local output="$1"
  local actor_id="$2"
  local thread_id="$3"
  local action="$4"

  "${BUDDYSWITCH_PYTHON}" - "${output}" "${actor_id}" "${thread_id}" "${action}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
payload = {
    "actor_id": sys.argv[2],
    "thread_id": sys.argv[3],
}
action = sys.argv[4]
if action in {"get", "set"}:
    payload["goal"] = source.get("goal")
elif action == "clear":
    payload["cleared"] = bool(source.get("cleared"))
print(json.dumps(payload, ensure_ascii=True))
PY
}

instance_goal() {
  local actor_id="${1:-}" action="${2:-}" json=0 objective="" status="" token_budget="" arg thread_id output
  if [[ -z "${actor_id}" || -z "${action}" ]]; then
    echo "instance goal requires <actor-id> get|set|clear" >&2
    return 2
  fi
  shift 2 || true

  case "${action}" in
    get|clear)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            json=1
            shift
            ;;
          *)
            echo "Unknown instance goal ${action} option: $1" >&2
            return 2
            ;;
        esac
      done
      ;;
    set)
      while [[ $# -gt 0 ]]; do
        arg="$1"
        case "${arg}" in
          --objective)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --objective <text>" >&2
              return 2
            fi
            objective="$2"
            shift 2
            ;;
          --status)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --status <status>" >&2
              return 2
            fi
            status="$2"
            shift 2
            ;;
          --token-budget)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --token-budget <tokens>" >&2
              return 2
            fi
            token_budget="$2"
            if ! [[ "${token_budget}" =~ ^[0-9]+$ ]]; then
              echo "instance goal set requires a numeric --token-budget value" >&2
              return 2
            fi
            shift 2
            ;;
          --json)
            json=1
            shift
            ;;
          *)
            echo "Unknown instance goal set option: ${arg}" >&2
            return 2
            ;;
        esac
      done
      if [[ -z "${objective}" && -z "${status}" && -z "${token_budget}" ]]; then
        echo "instance goal set requires --objective, --status, or --token-budget" >&2
        return 2
      fi
      ;;
    *)
      echo "Unknown instance goal action: ${action}" >&2
      return 2
      ;;
  esac

  instance_require_active_service_thread "${actor_id}" "goal" || return $?
  thread_id="${INSTANCE_ACTIVE_THREAD_ID}"
  case "${action}" in
    get)
      output="$(buddyswitch_app_server_goal_get "${thread_id}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
    set)
      output="$(buddyswitch_app_server_goal_set "${thread_id}" "${objective}" "${status}" "${token_budget}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
    clear)
      output="$(buddyswitch_app_server_goal_clear "${thread_id}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
  esac

  if [[ "${json}" -eq 1 ]]; then
    instance_goal_print_json "${output}" "${actor_id}" "${thread_id}" "${action}"
    return 0
  fi

  "${BUDDYSWITCH_PYTHON}" - "${output}" "${action}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
action = sys.argv[2]
if action == "clear":
    print(f"Goal cleared: {'yes' if source.get('cleared') else 'no'}")
else:
    goal = source.get("goal")
    if isinstance(goal, dict):
        print(f"Goal: {goal.get('objective') or ''}")
    else:
        print("No active goal.")
PY
}


instance_attach() {
  local actor_id="${1:-}" role thread_id socket_path output resumed_thread_id
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true
  if [[ $# -gt 0 ]]; then
    echo "Unknown instance attach option: $1" >&2
    return 2
  fi

  buddyswitch_validate_actor_id "${actor_id}" || return $?
  role="$(buddyswitch_instance_validate_record "${actor_id}")" || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${actor_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance attach blocked: ${actor_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance attach blocked: ${actor_id} is unhealthy or inactive." >&2
    return 3
  fi

  socket_path="$(buddyswitch_instance_record_field "${actor_id}" "app_server_socket" || true)"
  if [[ -z "${socket_path}" ]]; then
    socket_path="$(buddyswitch_app_server_socket)"
  fi

  output="$(buddyswitch_app_server_thread_resume "${thread_id}" 2>&1)" || {
    echo "thread/resume failed for ${thread_id}" >&2
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
  }
  resumed_thread_id="$(
    "${BUDDYSWITCH_PYTHON}" -c 'import json, sys; print(json.load(sys.stdin).get("thread", {}).get("id", ""))' <<<"${output}"
  )" || {
    echo "thread/resume returned invalid JSON for ${thread_id}" >&2
    return 1
  }
  if [[ "${resumed_thread_id}" != "${thread_id}" ]]; then
    echo "thread/resume returned unexpected thread id: ${resumed_thread_id}" >&2
    return 1
  fi

  cd "${BUDDYSWITCH_WORKSPACE_DIR}"
  BUDDYSWITCH_ROLE_ID="${role}" \
  BUDDYSWITCH_ACTOR_ID="${actor_id}" \
  BUDDYSWITCH_INSTANCE_JSON="${BUDDYSWITCH_INSTANCE_JSON}" \
    buddyswitch_run_codex resume --remote "unix://${socket_path}" "${thread_id}"
}


browser_ensure_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}"
  buddyswitch_require_runtime_lock
  if [[ -n "${actor_id}" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
  fi
  buddyswitch_browser_main ensure "$@"
}

browser_release_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}"
  buddyswitch_require_runtime_lock
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  buddyswitch_browser_main release
}

validate_reset_request() {
  local confirmed=0
  local arg=""
  for arg in "$@"; do
    if [[ "${arg}" == "--yes" ]]; then
      confirmed=1
    else
      echo "Unknown reset option: ${arg}" >&2
      echo "Use: buddyswitch-codex env reset --yes" >&2
      return 2
    fi
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "Reset requires explicit confirmation." >&2
    echo "Run: buddyswitch-codex env reset --yes" >&2
    return 1
  fi

  if ! buddyswitch_validate_reset_root; then
    return 2
  fi
}

reset_shared_env() {
  validate_reset_request "$@" || return $?
  buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-reset" "$@"
}

reset_shared_env_locked() {
  local active_count
  buddyswitch_require_runtime_lock
  validate_reset_request "$@" || return $?
  active_count="$(buddyswitch_count_active_app_servers)"
  if [[ "${active_count}" -gt 0 ]]; then
    echo "Reset blocked: ${active_count} active buddyswitch-codex instance(s) detected." >&2
    echo "Close active launcher sessions and retry." >&2
    return 3
  fi

  if buddyswitch_browser_is_active; then
    echo "Reset blocked: active browser cockpit detected." >&2
    echo "Stop the browser cockpit and retry." >&2
    return 3
  fi

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}" ]]; then
    buddyswitch_workspace_remove_registered_worktrees_under "${BUDDYSWITCH_SHARED_ROOT}"
    buddyswitch_workspace_force_remove_path "${BUDDYSWITCH_SHARED_ROOT}"
    echo "Reset complete: removed ${BUDDYSWITCH_SHARED_ROOT}"
  else
    echo "Nothing to reset: ${BUDDYSWITCH_SHARED_ROOT} does not exist"
  fi
}

data_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex data cleanup --role <role> [--yes] [--json]
  buddyswitch-codex data cleanup --all-data [--yes] [--json]
EOF
}

data_main() {
  local command="${1:-}"
  case "${command}" in
    cleanup)
      shift || true
      buddyswitch_cleanup_main "$@"
      ;;
    help|-h|--help|"")
      data_usage
      ;;
    *)
      echo "Unknown data command: ${command}" >&2
      data_usage >&2
      return 2
      ;;
  esac
}

env_status() {
  local json=0 arg instance_count=0 browser_state="inactive"
  for arg in "$@"; do
    case "${arg}" in
      --json)
        json=1
        ;;
      *)
        echo "Unknown env status option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}/instances" ]]; then
    instance_count="$(find "${BUDDYSWITCH_SHARED_ROOT}/instances" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  if buddyswitch_browser_is_active; then
    browser_state="active"
  fi

  if [[ "${json}" -eq 1 ]]; then
    "${BUDDYSWITCH_PYTHON}" - "${BUDDYSWITCH_SHARED_ROOT}" "${instance_count}" "${browser_state}" <<'PY'
import json
import sys

print(json.dumps({
    "shared_root": sys.argv[1],
    "instance_count": int(sys.argv[2]),
    "browser_state": sys.argv[3],
}, ensure_ascii=True))
PY
    return 0
  fi

  echo "BuddySwitch env status"
  echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
  echo "Instances: ${instance_count}"
  echo "Browser: ${browser_state}"
  echo "Next: ./buddyswitch-codex instance list"
}

env_reset() {
  local confirmed=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      *)
        echo "Unknown env reset option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch env reset preview"
    echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
    echo "Run with --yes to remove the shared BuddySwitch environment."
    return 0
  fi
  reset_shared_env "$@"
}

env_browser_validate_options() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --port)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --port" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        buddyswitch_browser_validate_port_option "$2" || return $?
        shift 2
        ;;
      --profile-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --profile-dir" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        shift 2
        ;;
      --help|-h)
        buddyswitch_browser_usage
        return 0
        ;;
      *)
        echo "Unknown browser option: ${arg}" >&2
        buddyswitch_browser_usage >&2
        return 2
        ;;
    esac
  done
}

env_browser_main() {
  local command="${1:-}" actor_id="" browser_port
  local explicit_port_requested=0 arg
  local -a browser_args=()
  if [[ -n "${command}" ]]; then
    shift || true
  fi

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --instance)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --instance" >&2
          env_usage >&2
          return 2
        fi
        actor_id="${2}"
        shift 2
        ;;
      *)
        browser_args+=("${1}")
        shift
        ;;
    esac
  done

  if [[ -n "${actor_id}" && "${command}" != "ensure" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
    browser_port="$(buddyswitch_instance_record_field "${actor_id}" "browser_port" || true)"
    if [[ -n "${browser_port}" ]]; then
      export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
    fi
    buddyswitch_browser_init_defaults
  fi

  case "${command}" in
    status)
      if [[ -z "${actor_id}" ]]; then
        export BUDDYSWITCH_BROWSER_PROFILE_DIR="${BUDDYSWITCH_RUN_STATE_DIR}/browser-status-profile"
        export BUDDYSWITCH_BROWSER_PROFILE_DIR_EXPLICIT=1
        export BUDDYSWITCH_BROWSER_LOG_FILE="${BUDDYSWITCH_RUN_STATE_DIR}/chrome-cockpit.log"
        export BUDDYSWITCH_BROWSER_LOG_FILE_EXPLICIT=1
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        buddyswitch_browser_main status "${browser_args[@]}"
      else
        buddyswitch_browser_main status
      fi
      ;;
    ensure)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser ensure requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      buddyswitch_validate_actor_id "${actor_id}" || return $?
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        env_browser_validate_options "${browser_args[@]}" || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        for arg in "${browser_args[@]}"; do
          if [[ "${arg}" == "--port" ]]; then
            explicit_port_requested=1
            break
          fi
        done
      fi
      if [[ "${explicit_port_requested}" -ne 1 ]]; then
        buddyswitch_browser_validate_env_or_default_port || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure" "${browser_args[@]}"
      else
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure"
      fi
      ;;
    release)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser release requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        echo "env browser release does not accept browser options" >&2
        env_usage >&2
        return 2
      fi
      BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
        buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-release"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "Unknown env browser command: ${command}" >&2
      env_usage >&2
      return 2
      ;;
  esac
}

env_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <actor-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <actor-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser release --instance <actor-id>
  buddyswitch-codex env reset [--yes]
EOF
}

env_main() {
  local command="${1:-}"
  case "${command}" in
    status)
      shift || true
      env_status "$@"
      ;;
    browser)
      shift || true
      env_browser_main "$@"
      ;;
    reset)
      shift || true
      env_reset "$@"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "env command is not available yet in this task stage." >&2
      env_usage >&2
      return 2
      ;;
  esac
}

legacy_command_hint() {
  local command="${1:-}"
  case "${command}" in
    start)
      echo "buddyswitch-codex instance start --role <role>"
      ;;
    role)
      echo "buddyswitch-codex instance roles"
      ;;
    cleanup)
      echo "buddyswitch-codex data cleanup ..."
      ;;
    reset)
      echo "buddyswitch-codex env reset --yes"
      ;;
    browser)
      echo "buddyswitch-codex env browser status|ensure ..."
      ;;
    workspace)
      echo "No public replacement. Use instance lifecycle commands."
      ;;
    *)
      echo "buddyswitch-codex help"
      ;;
  esac
}

fail_removed_public_command() {
  local command="${1:-}"
  local hint
  hint="$(legacy_command_hint "${command}")"
  echo "Top-level command removed: ${command}" >&2
  echo "Use: ${hint}" >&2
  return 2
}

fail_unknown_top_level_command() {
  local command="${1:-}"
  echo "Unknown top-level command: ${command}" >&2
  echo "Run: buddyswitch-codex help" >&2
  return 2
}

web_main() {
  buddyswitch_central_daemon_ensure || return $?
  local status
  if "${BUDDYSWITCH_PYTHON}" "${WEB_MANAGEMENT_HELPER}" "$@"; then
    status=0
  else
    status=$?
  fi
  buddyswitch_central_daemon_stop_if_idle
  return "${status}"
}

buddyswitch_instance_host_control() {
  "${BUDDYSWITCH_PYTHON}" -m tools.launcher.host_control "$@"
}

buddyswitch_instance_main() {
  local command="${1:-}"
  case "${command}" in
    roles|start|list|capabilities|compact|clear|resume|stop|status|interrupt|delete)
      shift || true
      buddyswitch_instance_host_control "${command}" "$@"
      ;;
    input)
      shift || true
      if [[ $# -lt 1 ]]; then
        echo "actor id is required" >&2
        print_help >&2
        return 2
      fi
      instance_input "$@"
      ;;
    side)
      shift || true
      if [[ "${1:-}" == "close" ]]; then
        shift || true
        if [[ $# -lt 1 ]]; then
          echo "actor id is required" >&2
          print_help >&2
          return 2
        fi
        instance_side_cleanup "$@"
        return $?
      fi
      if [[ $# -lt 1 ]]; then
        echo "actor id is required" >&2
        print_help >&2
        return 2
      fi
      instance_side "$@"
      ;;
    goal)
      shift || true
      if [[ $# -lt 2 ]]; then
        echo "actor id and goal action are required" >&2
        print_help >&2
        return 2
      fi
      instance_goal "$@"
      ;;
    attach)
      shift || true
      if [[ $# -lt 1 ]]; then
        echo "actor id is required" >&2
        print_help >&2
        return 2
      fi
      instance_attach "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    "")
      echo "instance command is required" >&2
      print_help >&2
      return 2
      ;;
    *)
      echo "Unknown instance command: ${command}" >&2
      print_help >&2
      return 2
      ;;
  esac
}

main() {
  local command="${1:-}"
  case "${command}" in
    __locked-reset)
      shift || true
      reset_shared_env_locked "$@"
      ;;
    __locked-browser-ensure)
      shift || true
      browser_ensure_locked "$@"
      ;;
    __locked-browser-release)
      shift || true
      browser_release_locked "$@"
      ;;
    __locked-cleanup)
      shift || true
      buddyswitch_cleanup_run_locked "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    instance)
      shift || true
      buddyswitch_instance_main "$@"
      ;;
    web)
      shift || true
      web_main "$@"
      ;;
    data)
      shift || true
      data_main "$@"
      ;;
    env)
      shift || true
      env_main "$@"
      ;;
    start|role|cleanup|reset|browser|workspace)
      fail_removed_public_command "${command}"
      ;;
    "")
      echo "Missing BuddySwitch command." >&2
      echo "Run: buddyswitch-codex help" >&2
      return 2
      ;;
    *)
      fail_unknown_top_level_command "${command}"
      ;;
  esac
}

main "$@"
