  resumed_thread_id="$(
    python3 -c 'import json, sys; print(json.load(sys.stdin).get("thread", {}).get("id", ""))' <<<"${output}"
  )" || {
    echo "thread/resume returned invalid JSON for ${thread_id}" >&2
