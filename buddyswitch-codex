#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
ENV_HELPER="${REPO_ROOT}/tools/launcher/env.sh"
WORKSPACE_HELPER="${REPO_ROOT}/tools/launcher/workspace.sh"
BROWSER_HELPER="${REPO_ROOT}/tools/launcher/browser_cockpit.sh"
APP_SERVER_HELPER="${REPO_ROOT}/tools/launcher/app_server.sh"
DAEMON_HELPER="${REPO_ROOT}/tools/launcher/daemon.sh"
HOST_CONTROL_HELPER="${REPO_ROOT}/tools/launcher/host_control.sh"
CLEANUP_HELPER="${REPO_ROOT}/tools/launcher/cleanup.sh"
RUNTIME_BROKER_HELPER="${REPO_ROOT}/tools/launcher/runtime_broker.sh"
WEB_MANAGEMENT_HELPER="${REPO_ROOT}/tools/launcher/web_management.py"

if [[ ! -f "${ENV_HELPER}" || ! -f "${WORKSPACE_HELPER}" || ! -f "${BROWSER_HELPER}" || ! -f "${APP_SERVER_HELPER}" || ! -f "${DAEMON_HELPER}" || ! -f "${HOST_CONTROL_HELPER}" || ! -f "${CLEANUP_HELPER}" || ! -f "${RUNTIME_BROKER_HELPER}" || ! -f "${WEB_MANAGEMENT_HELPER}" ]]; then
  echo "Launcher helpers are missing under tools/launcher." >&2
  exit 1
fi

source "${ENV_HELPER}"
source "${WORKSPACE_HELPER}"
source "${BROWSER_HELPER}"
source "${APP_SERVER_HELPER}"
source "${DAEMON_HELPER}"
source "${HOST_CONTROL_HELPER}"
source "${CLEANUP_HELPER}"
source "${RUNTIME_BROKER_HELPER}"

buddyswitch_env_init

print_help() {
  cat <<EOF
Usage:
  buddyswitch-codex instance roles [--json]
  buddyswitch-codex instance start --role <role> [--json]
  buddyswitch-codex instance input <actor-id> --text <text> [--json]
  buddyswitch-codex instance capabilities <actor-id> get [--json]
  buddyswitch-codex instance capabilities <actor-id> set --parent <level> --side <level> [--json]
  buddyswitch-codex instance compact <actor-id> [--json]
  buddyswitch-codex instance clear <actor-id> [--json]
  buddyswitch-codex instance attach <actor-id>
  buddyswitch-codex instance resume <actor-id> [--json]
  buddyswitch-codex instance stop <actor-id> [--json]
  buddyswitch-codex instance status <actor-id> [--json]
  buddyswitch-codex instance interrupt <actor-id> [--json]
  buddyswitch-codex instance list [--role <role>] [--json]
  buddyswitch-codex instance delete <actor-id> [--yes] [--json]
  buddyswitch-codex web [--host 127.0.0.1] [--port 8765]

  buddyswitch-codex data cleanup --role <role> [--yes] [--json]
  buddyswitch-codex data cleanup --all-data [--yes] [--json]

  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <actor-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <actor-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser release --instance <actor-id>
  buddyswitch-codex env reset [--yes]

  buddyswitch-codex help

Commands:
  instance Manage BuddySwitch product-mode instances.
  web      Run the local BuddySwitch web management server.
  data     Manage BuddySwitch data cleanup commands.
  env      Manage BuddySwitch environment status and reset commands.
  help     Show this help message.

Environment:
  BUDDYSWITCH_SHARED_ROOT      Shared launcher root (default: ${BUDDYSWITCH_SHARED_ROOT})
  BUDDYSWITCH_SOURCE_HOME      Source HOME for bootstrap (default: current HOME)
  BUDDYSWITCH_SOURCE_CODEX_HOME
                               Source CODEX_HOME for auth bootstrap
  BUDDYSWITCH_BROWSER_PORT     Browser cockpit port (default: ${BUDDYSWITCH_BROWSER_PORT:-9222})
  BUDDYSWITCH_BROWSER_PROFILE_DIR
                               Browser profile dir (default: ${BUDDYSWITCH_BROWSER_PROFILE_DIR:-<instance>/browser/profile})
  BUDDYSWITCH_BROWSER_LOG_FILE Browser Chrome log file (default: ${BUDDYSWITCH_BROWSER_LOG_FILE:-<instance>/browser/chrome.log})

Paths:
  shared root: ${BUDDYSWITCH_SHARED_ROOT}
  home: ${BUDDYSWITCH_HOME}
  codex home: ${BUDDYSWITCH_CODEX_HOME}
EOF
}


instance_input() {
  local actor_id="${1:-}" text="" arg json
  json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --text)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance input requires --text <text>" >&2
          return 2
        fi
        text="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance input option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${text}" ]]; then
    echo "instance input requires --text <text>" >&2
    return 2
  fi

  local -a command=(
    "${BUDDYSWITCH_PYTHON}" -m tools.launcher.actor_session
    --shared-root "${BUDDYSWITCH_SHARED_ROOT}"
    --repo-root "${REPO_ROOT}"
    input
    "${actor_id}"
    --text "${text}"
  )
  if [[ "${json}" -eq 1 ]]; then
    command+=(--json)
  fi
  PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}" "${command[@]}"
}

instance_attach() {
  local actor_id="${1:-}"
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true
  if [[ $# -gt 0 ]]; then
    echo "Unknown instance attach option: $1" >&2
    return 2
  fi

  PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}" \
    "${BUDDYSWITCH_PYTHON}" -m tools.launcher.actor_session \
      --shared-root "${BUDDYSWITCH_SHARED_ROOT}" \
      --repo-root "${REPO_ROOT}" \
      attach "${actor_id}"
}


browser_ensure_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}"
  buddyswitch_require_runtime_lock
  if [[ -n "${actor_id}" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
  fi
  buddyswitch_browser_main ensure "$@"
}

browser_release_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}"
  buddyswitch_require_runtime_lock
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  buddyswitch_browser_main release
}

validate_reset_request() {
  local confirmed=0
  local arg=""
  for arg in "$@"; do
    if [[ "${arg}" == "--yes" ]]; then
      confirmed=1
    else
      echo "Unknown reset option: ${arg}" >&2
      echo "Use: buddyswitch-codex env reset --yes" >&2
      return 2
    fi
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "Reset requires explicit confirmation." >&2
    echo "Run: buddyswitch-codex env reset --yes" >&2
    return 1
  fi

  if ! buddyswitch_validate_reset_root; then
    return 2
  fi
}

reset_shared_env() {
  validate_reset_request "$@" || return $?
  buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-reset" "$@"
}

reset_shared_env_locked() {
  local active_count
  buddyswitch_require_runtime_lock
  validate_reset_request "$@" || return $?
  active_count="$(buddyswitch_count_active_app_servers)"
  if [[ "${active_count}" -gt 0 ]]; then
    echo "Reset blocked: ${active_count} active buddyswitch-codex instance(s) detected." >&2
    echo "Close active launcher sessions and retry." >&2
    return 3
  fi

  if buddyswitch_browser_is_active; then
    echo "Reset blocked: active browser cockpit detected." >&2
    echo "Stop the browser cockpit and retry." >&2
    return 3
  fi

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}" ]]; then
    buddyswitch_workspace_remove_registered_worktrees_under "${BUDDYSWITCH_SHARED_ROOT}"
    buddyswitch_workspace_force_remove_path "${BUDDYSWITCH_SHARED_ROOT}"
    echo "Reset complete: removed ${BUDDYSWITCH_SHARED_ROOT}"
  else
    echo "Nothing to reset: ${BUDDYSWITCH_SHARED_ROOT} does not exist"
  fi
}

data_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex data cleanup --role <role> [--yes] [--json]
  buddyswitch-codex data cleanup --all-data [--yes] [--json]
EOF
}

data_main() {
  local command="${1:-}"
  case "${command}" in
    cleanup)
      shift || true
      buddyswitch_cleanup_main "$@"
      ;;
    help|-h|--help|"")
      data_usage
      ;;
    *)
      echo "Unknown data command: ${command}" >&2
      data_usage >&2
      return 2
      ;;
  esac
}

env_status() {
  local json=0 arg instance_count=0 browser_state="inactive"
  for arg in "$@"; do
    case "${arg}" in
      --json)
        json=1
        ;;
      *)
        echo "Unknown env status option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}/instances" ]]; then
    instance_count="$(find "${BUDDYSWITCH_SHARED_ROOT}/instances" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  if buddyswitch_browser_is_active; then
    browser_state="active"
  fi

  if [[ "${json}" -eq 1 ]]; then
    "${BUDDYSWITCH_PYTHON}" - "${BUDDYSWITCH_SHARED_ROOT}" "${instance_count}" "${browser_state}" <<'PY'
import json
import sys

print(json.dumps({
    "shared_root": sys.argv[1],
    "instance_count": int(sys.argv[2]),
    "browser_state": sys.argv[3],
}, ensure_ascii=True))
PY
    return 0
  fi

  echo "BuddySwitch env status"
  echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
  echo "Instances: ${instance_count}"
  echo "Browser: ${browser_state}"
  echo "Next: ./buddyswitch-codex instance list"
}

env_reset() {
  local confirmed=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      *)
        echo "Unknown env reset option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch env reset preview"
    echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
    echo "Run with --yes to remove the shared BuddySwitch environment."
    return 0
  fi
  reset_shared_env "$@"
}

env_browser_validate_options() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --port)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --port" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        buddyswitch_browser_validate_port_option "$2" || return $?
        shift 2
        ;;
      --profile-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --profile-dir" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        shift 2
        ;;
      --help|-h)
        buddyswitch_browser_usage
        return 0
        ;;
      *)
        echo "Unknown browser option: ${arg}" >&2
        buddyswitch_browser_usage >&2
        return 2
        ;;
    esac
  done
}

env_browser_main() {
  local command="${1:-}" actor_id="" browser_port
  local explicit_port_requested=0 arg
  local -a browser_args=()
  if [[ -n "${command}" ]]; then
    shift || true
  fi

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --instance)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --instance" >&2
          env_usage >&2
          return 2
        fi
        actor_id="${2}"
        shift 2
        ;;
      *)
        browser_args+=("${1}")
        shift
        ;;
    esac
  done

  if [[ -n "${actor_id}" && "${command}" != "ensure" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
    browser_port="$(buddyswitch_instance_record_field "${actor_id}" "browser_port" || true)"
    if [[ -n "${browser_port}" ]]; then
      export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
    fi
    buddyswitch_browser_init_defaults
  fi

  case "${command}" in
    status)
      if [[ -z "${actor_id}" ]]; then
        export BUDDYSWITCH_BROWSER_PROFILE_DIR="${BUDDYSWITCH_RUN_STATE_DIR}/browser-status-profile"
        export BUDDYSWITCH_BROWSER_PROFILE_DIR_EXPLICIT=1
        export BUDDYSWITCH_BROWSER_LOG_FILE="${BUDDYSWITCH_RUN_STATE_DIR}/chrome-cockpit.log"
        export BUDDYSWITCH_BROWSER_LOG_FILE_EXPLICIT=1
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        buddyswitch_browser_main status "${browser_args[@]}"
      else
        buddyswitch_browser_main status
      fi
      ;;
    ensure)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser ensure requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      buddyswitch_validate_actor_id "${actor_id}" || return $?
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        env_browser_validate_options "${browser_args[@]}" || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        for arg in "${browser_args[@]}"; do
          if [[ "${arg}" == "--port" ]]; then
            explicit_port_requested=1
            break
          fi
        done
      fi
      if [[ "${explicit_port_requested}" -ne 1 ]]; then
        buddyswitch_browser_validate_env_or_default_port || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure" "${browser_args[@]}"
      else
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure"
      fi
      ;;
    release)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser release requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        echo "env browser release does not accept browser options" >&2
        env_usage >&2
        return 2
      fi
      BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
        buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-release"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "Unknown env browser command: ${command}" >&2
      env_usage >&2
      return 2
      ;;
  esac
}

env_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <actor-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <actor-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser release --instance <actor-id>
  buddyswitch-codex env reset [--yes]
EOF
}

env_main() {
  local command="${1:-}"
  case "${command}" in
    status)
      shift || true
      env_status "$@"
      ;;
    browser)
      shift || true
      env_browser_main "$@"
      ;;
    reset)
      shift || true
      env_reset "$@"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "env command is not available yet in this task stage." >&2
      env_usage >&2
      return 2
      ;;
  esac
}

legacy_command_hint() {
  local command="${1:-}"
  case "${command}" in
    start)
      echo "buddyswitch-codex instance start --role <role>"
      ;;
    role)
      echo "buddyswitch-codex instance roles"
      ;;
    cleanup)
      echo "buddyswitch-codex data cleanup ..."
      ;;
    reset)
      echo "buddyswitch-codex env reset --yes"
      ;;
    browser)
      echo "buddyswitch-codex env browser status|ensure ..."
      ;;
    workspace)
      echo "No public replacement. Use instance lifecycle commands."
      ;;
    *)
      echo "buddyswitch-codex help"
      ;;
  esac
}

fail_removed_public_command() {
  local command="${1:-}"
  local hint
  hint="$(legacy_command_hint "${command}")"
  echo "Top-level command removed: ${command}" >&2
  echo "Use: ${hint}" >&2
  return 2
}

fail_unknown_top_level_command() {
  local command="${1:-}"
  echo "Unknown top-level command: ${command}" >&2
  echo "Run: buddyswitch-codex help" >&2
  return 2
}

web_main() {
  buddyswitch_central_daemon_ensure || return $?
  local status
  if "${BUDDYSWITCH_PYTHON}" "${WEB_MANAGEMENT_HELPER}" "$@"; then
    status=0
  else
    status=$?
  fi
  buddyswitch_central_daemon_stop_if_idle
  return "${status}"
}

buddyswitch_instance_host_control() {
  "${BUDDYSWITCH_PYTHON}" -m tools.launcher.host_control "$@"
}

buddyswitch_instance_main() {
  local command="${1:-}"
  case "${command}" in
    roles|start|list|capabilities|compact|clear|resume|stop|status|interrupt|delete)
      shift || true
      buddyswitch_instance_host_control "${command}" "$@"
      ;;
    input)
      shift || true
      if [[ $# -lt 1 ]]; then
        echo "actor id is required" >&2
        print_help >&2
        return 2
      fi
      instance_input "$@"
      ;;
    attach)
      shift || true
      if [[ $# -lt 1 ]]; then
        echo "actor id is required" >&2
        print_help >&2
        return 2
      fi
      instance_attach "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    "")
      echo "instance command is required" >&2
      print_help >&2
      return 2
      ;;
    *)
      echo "Unknown instance command: ${command}" >&2
      print_help >&2
      return 2
      ;;
  esac
}

main() {
  local command="${1:-}"
  case "${command}" in
    __locked-reset)
      shift || true
      reset_shared_env_locked "$@"
      ;;
    __locked-browser-ensure)
      shift || true
      browser_ensure_locked "$@"
      ;;
    __locked-browser-release)
      shift || true
      browser_release_locked "$@"
      ;;
    __locked-cleanup)
      shift || true
      buddyswitch_cleanup_run_locked "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    instance)
      shift || true
      buddyswitch_instance_main "$@"
      ;;
    web)
      shift || true
      web_main "$@"
      ;;
    data)
      shift || true
      data_main "$@"
      ;;
    env)
      shift || true
      env_main "$@"
      ;;
    start|role|cleanup|reset|browser|workspace)
      fail_removed_public_command "${command}"
      ;;
    "")
      echo "Missing BuddySwitch command." >&2
      echo "Run: buddyswitch-codex help" >&2
      return 2
      ;;
    *)
      fail_unknown_top_level_command "${command}"
      ;;
  esac
}

main "$@"
