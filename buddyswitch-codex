}

start_codex() {
  local role actor_id instance_json json arg bootstrap_stdout

  role=""
  actor_id=""
  instance_json=""
  json=0
  if [[ $# -eq 0 ]]; then
    echo "instance start requires --role <role>" >&2
    print_help >&2
    return 2
  fi

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --role)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --role" >&2
          print_help >&2
          return 2
        fi
        role="${2}"
        shift 2
        ;;
      --role=*)
        role="${arg#--role=}"
        if [[ -z "${role}" ]]; then
          echo "Missing value for --role" >&2
          print_help >&2
          return 2
        fi
        shift
        ;;
      --json)
        json=1
        shift
        ;;
      --)
        echo "instance start no longer accepts Codex args; use instance input after the service starts." >&2
        return 2
        ;;
      *)
        echo "Unknown instance start option: ${arg}" >&2
        print_help >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${role}" ]]; then
    echo "instance start requires --role <role>" >&2
    print_help >&2
    return 2
  fi

  buddyswitch_validate_role_id "${role}" || return $?
  actor_id="$(buddyswitch_generate_actor_id "${role}")"
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  instance_json="$(buddyswitch_instance_json_path "${actor_id}")"

  if [[ "${json}" -eq 1 ]]; then
    if ! bootstrap_stdout="$(
      (
        unset BUDDYSWITCH_ROLE_ID
        unset BUDDYSWITCH_ACTOR_ID
        unset BUDDYSWITCH_INSTANCE_JSON
        BUDDYSWITCH_START_ROLE="${role}" \
        BUDDYSWITCH_START_ACTOR_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-start-bootstrap"
      )
    )"; then
      if [[ -n "${bootstrap_stdout}" ]]; then
        printf '%s\n' "${bootstrap_stdout}" >&2
      fi
      return 1
    fi
  else
    (
      unset BUDDYSWITCH_ROLE_ID
      unset BUDDYSWITCH_ACTOR_ID
      unset BUDDYSWITCH_INSTANCE_JSON
      BUDDYSWITCH_START_ROLE="${role}" \
      BUDDYSWITCH_START_ACTOR_ID="${actor_id}" \
        buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-start-bootstrap"
    )
  fi

  if [[ "${json}" -eq 1 ]]; then
    python3 - "${actor_id}" "${role}" "${BUDDYSWITCH_WORKSPACE_DIR}" "${BUDDYSWITCH_PROJECT_WORKSPACE_DIR}" "${instance_json}" <<'PY'
import json
import sys

payload = {
    "actor_id": sys.argv[1],
    "role": sys.argv[2],
    "workspace_dir": sys.argv[3],
    "project_workspace_dir": sys.argv[4],
    "instance_record": sys.argv[5],
}
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi

  echo "BuddySwitch instance: ${actor_id} (${role})"
  echo "Workspace: ${BUDDYSWITCH_WORKSPACE_DIR}"
  echo "Project workspace: ${BUDDYSWITCH_PROJECT_WORKSPACE_DIR}"
  echo "Instance record: ${instance_json}"
  echo "Input: ./buddyswitch-codex instance input ${actor_id} --text \"<text>\""
  echo "Attach: ./buddyswitch-codex instance attach ${actor_id}"
  echo "Stop: ./buddyswitch-codex instance stop ${actor_id}"
  echo "Delete instance: ./buddyswitch-codex instance delete ${actor_id} --yes"
}

buddyswitch_start_failure_cleanup() {
  local actor_id="$1"
  local phase="$2"
  local message="$3"
  local thread_id="${4:-}"
  local browser_port="${5:-}"
  local stop_output=""

  stop_output="$(buddyswitch_app_server_stop 2>&1)" || {
    echo "Warning: app-server stop failed during ${phase} cleanup for ${actor_id}." >&2
    [[ -n "${stop_output}" ]] && echo "${stop_output}" >&2
  }
  buddyswitch_runtime_broker_stop || true
  buddyswitch_browser_instance_stop "${actor_id}" || true
  buddyswitch_instance_clear_app_server "${actor_id}" "inactive"
  buddyswitch_instance_record_failure "${actor_id}" "${phase}" "${message}" "${thread_id}" "${browser_port}"
}

buddyswitch_thread_bootstrap_failure_is_timeout_like() {
  local message="$1"

  [[ "${message}" == *"timed out waiting for thread/inject_items"* ]] ||
    [[ "${message}" == *"timed out waiting for thread/bootstrap"* ]] ||
    [[ "${message}" == *"AppServerTimeout"* ]]
}

buddyswitch_start_thread_bootstrap_with_retry() {
  local thread_id="$1"
  local output retry_output

  BUDDYSWITCH_LAST_THREAD_BOOTSTRAP_ERROR=""
  if output="$(buddyswitch_app_server_thread_bootstrap "${thread_id}" 2>&1)"; then
    return 0
  fi
  BUDDYSWITCH_LAST_THREAD_BOOTSTRAP_ERROR="${output}"
  if ! buddyswitch_thread_bootstrap_failure_is_timeout_like "${output}"; then
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
  fi

  echo "Thread bootstrap timed out for ${thread_id}; retrying once." >&2
  if retry_output="$(buddyswitch_app_server_thread_bootstrap "${thread_id}" 2>&1)"; then
    BUDDYSWITCH_LAST_THREAD_BOOTSTRAP_ERROR=""
    return 0
  fi
  BUDDYSWITCH_LAST_THREAD_BOOTSTRAP_ERROR="${retry_output:-${output}}"
  [[ -n "${retry_output}" ]] && echo "${retry_output}" >&2
  return 1
}

start_locked_bootstrap() {
  local requested_role requested_actor_id app_server_json thread_json thread_id
  buddyswitch_require_runtime_lock
  requested_role="${BUDDYSWITCH_START_ROLE:-}"
  requested_actor_id="${BUDDYSWITCH_START_ACTOR_ID:-}"

  if [[ -z "${requested_role}" ]]; then
    echo "BUDDYSWITCH_START_ROLE is required for product instance bootstrap." >&2
    return 2
  fi
  if [[ -z "${requested_actor_id}" ]]; then
    echo "BUDDYSWITCH_START_ACTOR_ID is required for product instance bootstrap." >&2
    return 2
  fi
  buddyswitch_validate_role_id "${requested_role}" || return $?
  buddyswitch_validate_actor_id "${requested_actor_id}" || return $?
  buddyswitch_require_env_profile "${requested_role}" || return $?
  buddyswitch_require_role_agents_template "${requested_role}" || return $?
  buddyswitch_env_bind_instance "${requested_actor_id}" || return $?

  buddyswitch_ensure_shared_env
  buddyswitch_workspace_prepare_execution_worktree

  buddyswitch_workspace_ensure_project_worktree
  buddyswitch_workspace_repair_runtime_projects_app_projection
  buddyswitch_instance_ensure_private_writable_surface
  buddyswitch_instance_activate "${requested_actor_id}" "${requested_role}" "inactive" >/dev/null
  buddyswitch_runtime_broker_ensure
  buddyswitch_patch_codex_config
  if ! buddyswitch_env_mcp_ensure; then
    buddyswitch_runtime_broker_stop
    return 1
  fi
  if ! buddyswitch_browser_register_cockpit_mcp; then
    buddyswitch_runtime_broker_stop
    return 1
  fi
  app_server_json="$(buddyswitch_app_server_ensure)" || {
    buddyswitch_start_failure_cleanup \
      "${requested_actor_id}" \
      "app_server_ensure" \
      "App-server ensure failed." \
      "" \
      ""
    return 1
  }
  thread_json="$(buddyswitch_app_server_thread_start)" || {
    buddyswitch_start_failure_cleanup \
      "${requested_actor_id}" \
      "thread_start" \
      "${thread_json:-thread/start failed.}" \
      "" \
      ""
    return 1
  }
  thread_id="$(
    python3 - "${thread_json}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
thread = payload.get("thread")
if isinstance(thread, dict):
    thread_id = thread.get("id")
    if isinstance(thread_id, str):
        print(thread_id)
PY
  )"
  if [[ -z "${thread_id}" ]]; then
    echo "App-server thread start did not return thread.id." >&2
    echo "${thread_json}" >&2
    buddyswitch_start_failure_cleanup \
      "${requested_actor_id}" \
      "thread_start" \
      "App-server thread start did not return thread.id." \
      "" \
      ""
    return 1
  fi
  if ! buddyswitch_start_thread_bootstrap_with_retry "${thread_id}"; then
    echo "Thread bootstrap failed for ${thread_id}." >&2
    buddyswitch_start_failure_cleanup \
      "${requested_actor_id}" \
      "thread_bootstrap" \
      "${BUDDYSWITCH_LAST_THREAD_BOOTSTRAP_ERROR:-Thread bootstrap failed for ${thread_id}.}" \
      "${thread_id}" \
      ""
    return 1
  fi
  buddyswitch_instance_set_app_server \
    "${requested_actor_id}" \
    "${thread_id}" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "pid")" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "socket_path")" \
    "$(_buddyswitch_app_server_json_field "${app_server_json}" "log_file")" \
    "active"
  if ! buddyswitch_daemon_start >/dev/null; then
    echo "Daemon start failed for ${requested_actor_id}." >&2
    buddyswitch_app_server_stop || true
    buddyswitch_runtime_broker_stop
    buddyswitch_browser_instance_stop "${requested_actor_id}" || true
    buddyswitch_instance_clear_app_server "${requested_actor_id}" "inactive"
    return 1
  fi
}

instance_set_inactive_locked() {
  local actor_id="${1:-}" daemon_output=""
  buddyswitch_require_runtime_lock
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  daemon_output="$(buddyswitch_daemon_stop 2>&1)" || {
    echo "Warning: daemon stop failed for ${actor_id}." >&2
    [[ -n "${daemon_output}" ]] && echo "${daemon_output}" >&2
  }
  buddyswitch_app_server_stop || true
  buddyswitch_runtime_broker_stop
  buddyswitch_browser_instance_stop "${actor_id}" || true
  buddyswitch_instance_clear_app_server "${actor_id}" "inactive"
}

instance_input() {
  local actor_id="${1:-}" text="" thread_id="" role_id="" arg output runtime_output instruction_json task_id json
  json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --text)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance input requires --text <text>" >&2
          return 2
        fi
        text="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance input option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${text}" ]]; then
    echo "instance input requires --text <text>" >&2
    return 2
  fi

  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${actor_id}" "thread_id" || true)"
  role_id="$(buddyswitch_instance_record_field "${actor_id}" "role" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance input blocked: ${actor_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if [[ -z "${role_id}" ]]; then
    echo "Instance input blocked: ${actor_id} has no role; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance input blocked: ${actor_id} is unhealthy or inactive." >&2
    return 3
  fi

  output="$(
    BUDDYSWITCH_STATE_ROOT="${BUDDYSWITCH_SHARED_ROOT}/state" \
    python3 "${TASK_SYS_INGRESS_HELPER}" user-input \
      --actor-id "${actor_id}" \
      --role-id "${role_id}" \
      --thread-id "${thread_id}" \
      --text "${text}" \
      --surface "cli" 2>&1
  )" || {
    if [[ -n "${output}" ]]; then
      echo "${output}" >&2
    fi
    return 1
  }
  instruction_json="$(
    python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
instruction = payload.get("instruction")
if not isinstance(instruction, dict):
    raise SystemExit("Task Sys ingress did not return an instruction")
print(json.dumps(instruction, ensure_ascii=True))
PY
  )" || return 1
  runtime_output="$(
    python3 "${TASK_SYS_RUNTIME_HELPER}" execute \
      --instance-json "${BUDDYSWITCH_INSTANCE_JSON}" \
      --instruction-json "${instruction_json}" 2>&1
  )" || {
    [[ -n "${runtime_output}" ]] && echo "${runtime_output}" >&2
    return 1
  }

  if [[ "${json}" -eq 1 ]]; then
    python3 - "${output}" "${runtime_output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
payload["runtime"] = json.loads(sys.argv[2])
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi
  task_id="$(
    python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get("task_id")
if isinstance(value, str):
    print(value)
PY
  )"
  echo "Task created: ${task_id}"
}

instance_side_print_start_result() {
  local output="$1" actor_id="$2" parent_thread_id="$3" side_thread_id="$4" json="$5"
  if [[ "${json}" -eq 1 ]]; then
    python3 - "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
payload = {
    "actor_id": sys.argv[2],
    "parent_thread_id": sys.argv[3],
    "side_thread_id": sys.argv[4],
    "action": "start",
    "thread_action": source.get("thread_action"),
}
for key in ("turn_id", "expected_turn_id"):
    value = source.get(key)
    if isinstance(value, str) and value:
        payload[key] = value
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi
  echo "Side conversation started: ${side_thread_id}"
}

instance_side_print_send_result() {
  local output="$1" actor_id="$2" parent_thread_id="$3" side_thread_id="$4" json="$5"
  if [[ "${json}" -eq 1 ]]; then
    python3 - "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
payload = {
    "actor_id": sys.argv[2],
    "parent_thread_id": sys.argv[3],
    "side_thread_id": sys.argv[4],
    "action": "send",
    "thread_action": source.get("action"),
}
for key in ("turn_id", "expected_turn_id"):
    value = source.get(key)
    if isinstance(value, str) and value:
        payload[key] = value
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi
  echo "Side conversation sent: ${side_thread_id}"
}

instance_side() {
  local actor_id="${1:-}" text="" side_thread_id="" parent_thread_id="" arg output json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --text)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side requires --text <text>" >&2
          return 2
        fi
        text="$2"
        shift 2
        ;;
      --side-thread-id)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "instance side requires --side-thread-id <side-thread-id>" >&2
          return 2
        fi
        side_thread_id="$2"
        shift 2
        ;;
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance side option: ${arg}" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${text}" ]]; then
    echo "instance side requires --text <text>" >&2
    return 2
  fi

  instance_require_active_service_thread "${actor_id}" "side" || return $?
  parent_thread_id="${INSTANCE_ACTIVE_THREAD_ID}"

  if [[ -n "${side_thread_id}" ]]; then
    buddyswitch_instance_require_side_thread "${actor_id}" "${parent_thread_id}" "${side_thread_id}" >/dev/null || return $?
    output="$(buddyswitch_app_server_input "${side_thread_id}" "${text}" 2>&1)" || {
      if [[ "${output}" == *"turn/steer failed"* ]]; then
        echo "Instance side blocked: active turn is not steerable; retry later or close it." >&2
        echo "${output}" >&2
        return 1
      fi
      [[ -n "${output}" ]] && echo "${output}" >&2
      return 1
    }
    instance_side_print_send_result "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" "${json}"
    return $?
  fi

  output="$(buddyswitch_app_server_side_start "${parent_thread_id}" "${text}" 2>&1)" || {
    [[ -n "${output}" ]] && echo "${output}" >&2
    return 1
  }
  side_thread_id="$(
    python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get("side_thread_id")
if isinstance(value, str):
    print(value)
PY
  )"
  if [[ -z "${side_thread_id}" ]]; then
    echo "Side start returned no side_thread_id." >&2
    return 1
  fi
  buddyswitch_instance_register_side_thread "${actor_id}" "${parent_thread_id}" "${side_thread_id}" || return $?
  instance_side_print_start_result "${output}" "${actor_id}" "${parent_thread_id}" "${side_thread_id}" "${json}"
}

instance_require_active_service_thread() {
  local actor_id="$1"
  local action_label="$2"
  local thread_id

  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${actor_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance ${action_label} blocked: ${actor_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance ${action_label} blocked: ${actor_id} is unhealthy or inactive." >&2
    return 3
  fi
  INSTANCE_ACTIVE_THREAD_ID="${thread_id}"
}

instance_side_close() {
