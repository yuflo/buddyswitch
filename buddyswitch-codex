#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
ENV_HELPER="${REPO_ROOT}/tools/launcher/env.sh"
WORKSPACE_HELPER="${REPO_ROOT}/tools/launcher/workspace.sh"
BROWSER_HELPER="${REPO_ROOT}/tools/launcher/browser_cockpit.sh"
APP_SERVER_HELPER="${REPO_ROOT}/tools/launcher/app_server.sh"
SUBMIT_TURN_HELPER="${REPO_ROOT}/tools/launcher/submit_turn.py"
TASK_SYS_INGRESS_HELPER="${REPO_ROOT}/tools/launcher/task_sys_ingress.py"
TASK_SYS_RUNTIME_HELPER="${REPO_ROOT}/tools/launcher/task_sys_runtime.py"
DAEMON_HELPER="${REPO_ROOT}/tools/launcher/daemon.sh"
INSTANCE_HELPER="${REPO_ROOT}/tools/launcher/instance.sh"
CLEANUP_HELPER="${REPO_ROOT}/tools/launcher/cleanup.sh"
RUNTIME_BROKER_HELPER="${REPO_ROOT}/tools/launcher/runtime_broker.sh"
WEB_MANAGEMENT_HELPER="${REPO_ROOT}/tools/launcher/web_management.py"

if [[ ! -f "${ENV_HELPER}" || ! -f "${WORKSPACE_HELPER}" || ! -f "${BROWSER_HELPER}" || ! -f "${APP_SERVER_HELPER}" || ! -f "${SUBMIT_TURN_HELPER}" || ! -f "${TASK_SYS_INGRESS_HELPER}" || ! -f "${TASK_SYS_RUNTIME_HELPER}" || ! -f "${DAEMON_HELPER}" || ! -f "${INSTANCE_HELPER}" || ! -f "${CLEANUP_HELPER}" || ! -f "${RUNTIME_BROKER_HELPER}" || ! -f "${WEB_MANAGEMENT_HELPER}" ]]; then
  echo "Launcher helpers are missing under tools/launcher." >&2
  exit 1
fi

source "${ENV_HELPER}"
source "${WORKSPACE_HELPER}"
source "${BROWSER_HELPER}"
source "${APP_SERVER_HELPER}"
source "${DAEMON_HELPER}"
source "${INSTANCE_HELPER}"
source "${CLEANUP_HELPER}"
source "${RUNTIME_BROKER_HELPER}"

buddyswitch_env_init

