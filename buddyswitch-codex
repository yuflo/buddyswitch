instance_goal() {
  local actor_id="${1:-}" action="${2:-}" json=0 objective="" status="" token_budget="" arg thread_id output
  if [[ -z "${actor_id}" || -z "${action}" ]]; then
    echo "instance goal requires <actor-id> get|set|clear" >&2
    return 2
  fi
  shift 2 || true

  case "${action}" in
    get|clear)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)
            json=1
            shift
            ;;
          *)
            echo "Unknown instance goal ${action} option: $1" >&2
            return 2
            ;;
        esac
      done
      ;;
    set)
      while [[ $# -gt 0 ]]; do
        arg="$1"
        case "${arg}" in
          --objective)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --objective <text>" >&2
              return 2
            fi
            objective="$2"
            shift 2
            ;;
          --status)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --status <status>" >&2
              return 2
            fi
            status="$2"
            shift 2
            ;;
          --token-budget)
            if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
              echo "instance goal set requires --token-budget <tokens>" >&2
              return 2
            fi
            token_budget="$2"
            if ! [[ "${token_budget}" =~ ^[0-9]+$ ]]; then
              echo "instance goal set requires a numeric --token-budget value" >&2
              return 2
            fi
            shift 2
            ;;
          --json)
            json=1
            shift
            ;;
          *)
            echo "Unknown instance goal set option: ${arg}" >&2
            return 2
            ;;
        esac
      done
      if [[ -z "${objective}" && -z "${status}" && -z "${token_budget}" ]]; then
        echo "instance goal set requires --objective, --status, or --token-budget" >&2
        return 2
      fi
      ;;
    *)
      echo "Unknown instance goal action: ${action}" >&2
      return 2
      ;;
  esac

  instance_require_active_service_thread "${actor_id}" "goal" || return $?
  thread_id="${INSTANCE_ACTIVE_THREAD_ID}"
  case "${action}" in
    get)
      output="$(buddyswitch_app_server_goal_get "${thread_id}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
    set)
      output="$(buddyswitch_app_server_goal_set "${thread_id}" "${objective}" "${status}" "${token_budget}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
    clear)
      output="$(buddyswitch_app_server_goal_clear "${thread_id}" 2>&1)" || {
        [[ -n "${output}" ]] && echo "${output}" >&2
        return 1
      }
      ;;
  esac

  if [[ "${json}" -eq 1 ]]; then
    instance_goal_print_json "${output}" "${actor_id}" "${thread_id}" "${action}"
    return 0
  fi

  python3 - "${output}" "${action}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
action = sys.argv[2]
if action == "clear":
    print(f"Goal cleared: {'yes' if source.get('cleared') else 'no'}")
else:
    goal = source.get("goal")
    if isinstance(goal, dict):
        print(f"Goal: {goal.get('objective') or ''}")
    else:
        print("No active goal.")
PY
}

