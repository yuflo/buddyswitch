    if isinstance(status, str) and isinstance(count, int)
)

print(f"Instance: {payload.get('actor_id')}")
print(f"Buddy: {payload.get('role')}")
print(f"Status: {payload.get('status')}")
print(f"App-server health: {'healthy' if app_server.get('healthy') else 'unhealthy'}")
print(f"Daemon health: {'healthy' if daemon.get('live') else 'unhealthy'}")
print(f"Daemon handlers: {handler_text}")
print(f"Task Sys active: {task_sys_active}")
if task_sys_status_text:
    print(f"Task Sys active statuses: {task_sys_status_text}")
print("Delivery scope: daemon handler status is trigger-dispatch only; external channel delivery is separate.")
print(f"Thread id: {payload.get('thread_id') or ''}")
print(f"Thread status: {thread.get('status') or ''}")
print(f"Browser port: {payload.get('browser_port') or ''}")
print(f"Workspace: {payload.get('workspace_dir') or ''}")
print(f"Updated: {payload.get('updated_at') or ''}")
PY
}

instance_interrupt() {
  local actor_id="${1:-}" thread_id output json=0
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json=1
        shift
        ;;
      *)
        echo "Unknown instance interrupt option: $1" >&2
        return 2
        ;;
    esac
  done

  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  thread_id="$(buddyswitch_instance_record_field "${actor_id}" "thread_id" || true)"
  if [[ -z "${thread_id}" ]]; then
    echo "Instance interrupt blocked: ${actor_id} has no thread id; stop/delete it and start a new instance." >&2
    return 3
  fi
  if ! buddyswitch_app_server_is_active; then
    echo "Instance interrupt blocked: ${actor_id} is unhealthy or inactive." >&2
    return 3
  fi

  output="$(buddyswitch_app_server_interrupt "${thread_id}" 2>&1)" || {
    if [[ -n "${output}" ]]; then
      echo "${output}" >&2
    fi
    return 1
  }

  if [[ "${json}" -eq 1 ]]; then
    python3 - "${output}" "${actor_id}" "${thread_id}" <<'PY'
import json
import sys

source = json.loads(sys.argv[1])
payload = {
    "actor_id": sys.argv[2],
    "thread_id": sys.argv[3],
    "turn_id": source.get("turn_id"),
}
print(json.dumps(payload, ensure_ascii=True))
PY
    return 0
  fi

  python3 - "${output}" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
turn_id = payload.get("turn_id")
print(f"Interrupted turn: {turn_id or ''}")
PY
}

instance_delete() {
  local actor_id="${1:-}" confirmed=0 json=0 arg delete_stdout
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  shift || true
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      --json)
        json=1
        ;;
      *)
        echo "Unknown instance delete option: ${arg}" >&2
        buddyswitch_instance_usage >&2
        return 2
        ;;
    esac
  done

  buddyswitch_validate_actor_id "${actor_id}" || return $?
  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch instance delete preview"
    echo "Instance: ${actor_id}"
    echo "Instance root: $(buddyswitch_instance_root "${actor_id}")"
    echo "Shared state kept: ${BUDDYSWITCH_SHARED_ROOT}/state"
    echo "Run with --yes to delete this instance root."
    return 0
  fi

  if [[ "${json}" -eq 1 ]]; then
    if ! delete_stdout="$(
      BUDDYSWITCH_DELETE_ACTOR_ID="${actor_id}" \
        buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-instance-delete"
    )"; then
      if [[ -n "${delete_stdout}" ]]; then
        printf '%s\n' "${delete_stdout}" >&2
      fi
      return 1
    fi
    python3 - "${actor_id}" <<'PY'
import json
import sys

print(json.dumps({"actor_id": sys.argv[1], "deleted": True}, ensure_ascii=True))
PY
    return 0
  fi

  BUDDYSWITCH_DELETE_ACTOR_ID="${actor_id}" \
    buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-instance-delete"
}

instance_delete_locked() {
  local actor_id instance_root
  buddyswitch_require_runtime_lock
  actor_id="${BUDDYSWITCH_DELETE_ACTOR_ID:-}"
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  instance_root="$(buddyswitch_instance_require_safe_delete_root "${actor_id}")" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?

  if buddyswitch_instance_app_server_is_active "${actor_id}"; then
    echo "Instance delete blocked: ${actor_id} is active." >&2
    return 3
  fi
  if buddyswitch_browser_instance_pid_marker_is_active "${actor_id}"; then
    echo "Instance delete blocked: active browser cockpit detected for ${actor_id}." >&2
    return 3
  fi
  local browser_ownership
  browser_ownership="$(buddyswitch_browser_instance_endpoint_ownership_state "${actor_id}")"
  if [[ "${browser_ownership}" == "owned" ]]; then
    echo "Instance delete blocked: active browser cockpit detected for ${actor_id}." >&2
    return 3
  fi
  if [[ "${browser_ownership}" == "unknown" ]]; then
    echo "Instance delete blocked: active browser cockpit ownership could not be verified for ${actor_id}." >&2
    return 3
  fi

  buddyswitch_runtime_broker_stop
  buddyswitch_workspace_remove_registered_worktrees_under_strict "${instance_root}" || return $?
  buddyswitch_workspace_force_remove_path "${instance_root}"
  echo "Instance deleted: ${actor_id}"
}

browser_ensure_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}" browser_port explicit_port_requested=0 arg
  buddyswitch_require_runtime_lock
  for arg in "$@"; do
    if [[ "${arg}" == "--port" ]]; then
      explicit_port_requested=1
      break
    fi
  done
  if [[ -n "${actor_id}" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
    if [[ "${explicit_port_requested}" -eq 0 ]]; then
      buddyswitch_browser_prepare_instance_ensure_port "${actor_id}" || return $?
    else
      browser_port="$(buddyswitch_instance_record_field "${actor_id}" "browser_port" || true)"
      if [[ -n "${browser_port}" ]]; then
        export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
      fi
      buddyswitch_browser_init_defaults
    fi
  fi
  buddyswitch_browser_main ensure "$@"
  if [[ -n "${actor_id}" ]]; then
    buddyswitch_instance_set_browser_port "${actor_id}" "${BUDDYSWITCH_BROWSER_PORT}"
  fi
}

browser_release_locked() {
  local actor_id="${BUDDYSWITCH_BROWSER_INSTANCE_ID:-}"
  buddyswitch_require_runtime_lock
  if [[ -z "${actor_id}" ]]; then
    echo "actor id is required" >&2
    return 2
  fi
  buddyswitch_validate_actor_id "${actor_id}" || return $?
  buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
  buddyswitch_env_bind_instance "${actor_id}" || return $?
  buddyswitch_browser_init_defaults
  buddyswitch_browser_main release
}

validate_reset_request() {
  local confirmed=0
  local arg=""
  for arg in "$@"; do
    if [[ "${arg}" == "--yes" ]]; then
      confirmed=1
    else
      echo "Unknown reset option: ${arg}" >&2
      echo "Use: buddyswitch-codex env reset --yes" >&2
      return 2
    fi
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "Reset requires explicit confirmation." >&2
    echo "Run: buddyswitch-codex env reset --yes" >&2
    return 1
  fi

  if ! buddyswitch_validate_reset_root; then
    return 2
  fi
}

reset_shared_env() {
  validate_reset_request "$@" || return $?
  buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-reset" "$@"
}

reset_shared_env_locked() {
  local active_count
  buddyswitch_require_runtime_lock
  validate_reset_request "$@" || return $?
  active_count="$(buddyswitch_count_active_app_servers)"
  if [[ "${active_count}" -gt 0 ]]; then
    echo "Reset blocked: ${active_count} active buddyswitch-codex instance(s) detected." >&2
    echo "Close active launcher sessions and retry." >&2
    return 3
  fi

  if buddyswitch_browser_is_active; then
    echo "Reset blocked: active browser cockpit detected." >&2
    echo "Stop the browser cockpit and retry." >&2
    return 3
  fi

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}" ]]; then
    buddyswitch_workspace_remove_registered_worktrees_under "${BUDDYSWITCH_SHARED_ROOT}"
    buddyswitch_workspace_force_remove_path "${BUDDYSWITCH_SHARED_ROOT}"
    echo "Reset complete: removed ${BUDDYSWITCH_SHARED_ROOT}"
  else
    echo "Nothing to reset: ${BUDDYSWITCH_SHARED_ROOT} does not exist"
  fi
}

