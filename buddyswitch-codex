env_status() {
  local json=0 arg instance_count=0 browser_state="inactive"
  for arg in "$@"; do
    case "${arg}" in
      --json)
        json=1
        ;;
      *)
        echo "Unknown env status option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ -d "${BUDDYSWITCH_SHARED_ROOT}/instances" ]]; then
    instance_count="$(find "${BUDDYSWITCH_SHARED_ROOT}/instances" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  if buddyswitch_browser_is_active; then
    browser_state="active"
  fi

  if [[ "${json}" -eq 1 ]]; then
    python3 - "${BUDDYSWITCH_SHARED_ROOT}" "${instance_count}" "${browser_state}" <<'PY'
import json
import sys

print(json.dumps({
    "shared_root": sys.argv[1],
    "instance_count": int(sys.argv[2]),
    "browser_state": sys.argv[3],
}, ensure_ascii=True))
PY
    return 0
  fi

  echo "BuddySwitch env status"
  echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
  echo "Instances: ${instance_count}"
  echo "Browser: ${browser_state}"
  echo "Next: ./buddyswitch-codex instance list"
}

env_reset() {
  local confirmed=0 arg
  for arg in "$@"; do
    case "${arg}" in
      --yes)
        confirmed=1
        ;;
      *)
        echo "Unknown env reset option: ${arg}" >&2
        env_usage >&2
        return 2
        ;;
    esac
  done

  if [[ "${confirmed}" -ne 1 ]]; then
    echo "BuddySwitch env reset preview"
    echo "Shared root: ${BUDDYSWITCH_SHARED_ROOT}"
    echo "Run with --yes to remove the shared BuddySwitch environment."
    return 0
  fi
  reset_shared_env "$@"
}

env_browser_validate_options() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "${arg}" in
      --port)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --port" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        buddyswitch_browser_validate_port_option "$2" || return $?
        shift 2
        ;;
      --profile-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --profile-dir" >&2
          buddyswitch_browser_usage >&2
          return 2
        fi
        shift 2
        ;;
      --help|-h)
        buddyswitch_browser_usage
        return 0
        ;;
      *)
        echo "Unknown browser option: ${arg}" >&2
        buddyswitch_browser_usage >&2
        return 2
        ;;
    esac
  done
}

env_browser_main() {
  local command="${1:-}" actor_id="" browser_port
  local explicit_port_requested=0 arg
  local -a browser_args=()
  if [[ -n "${command}" ]]; then
    shift || true
  fi

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --instance)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "Missing value for --instance" >&2
          env_usage >&2
          return 2
        fi
        actor_id="${2}"
        shift 2
        ;;
      *)
        browser_args+=("${1}")
        shift
        ;;
    esac
  done

  if [[ -n "${actor_id}" && "${command}" != "ensure" ]]; then
    buddyswitch_validate_actor_id "${actor_id}" || return $?
    buddyswitch_instance_validate_record "${actor_id}" >/dev/null || return $?
    buddyswitch_env_bind_instance "${actor_id}" || return $?
    browser_port="$(buddyswitch_instance_record_field "${actor_id}" "browser_port" || true)"
    if [[ -n "${browser_port}" ]]; then
      export BUDDYSWITCH_BROWSER_PORT="${browser_port}"
    fi
    buddyswitch_browser_init_defaults
  fi

  case "${command}" in
    status)
      if [[ -z "${actor_id}" ]]; then
        export BUDDYSWITCH_BROWSER_PROFILE_DIR="${BUDDYSWITCH_RUN_STATE_DIR}/browser-status-profile"
        export BUDDYSWITCH_BROWSER_PROFILE_DIR_EXPLICIT=1
        export BUDDYSWITCH_BROWSER_LOG_FILE="${BUDDYSWITCH_RUN_STATE_DIR}/chrome-cockpit.log"
        export BUDDYSWITCH_BROWSER_LOG_FILE_EXPLICIT=1
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        buddyswitch_browser_main status "${browser_args[@]}"
      else
        buddyswitch_browser_main status
      fi
      ;;
    ensure)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser ensure requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      buddyswitch_validate_actor_id "${actor_id}" || return $?
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        env_browser_validate_options "${browser_args[@]}" || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        for arg in "${browser_args[@]}"; do
          if [[ "${arg}" == "--port" ]]; then
            explicit_port_requested=1
            break
          fi
        done
      fi
      if [[ "${explicit_port_requested}" -ne 1 ]]; then
        buddyswitch_browser_validate_env_or_default_port || return $?
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure" "${browser_args[@]}"
      else
        BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
          buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-ensure"
      fi
      ;;
    release)
      if [[ -z "${actor_id}" ]]; then
        echo "env browser release requires --instance <actor-id>" >&2
        env_usage >&2
        return 2
      fi
      if [[ "${#browser_args[@]}" -gt 0 ]]; then
        echo "env browser release does not accept browser options" >&2
        env_usage >&2
        return 2
      fi
      BUDDYSWITCH_BROWSER_INSTANCE_ID="${actor_id}" \
        buddyswitch_with_runtime_lock "${REPO_ROOT}/buddyswitch-codex" "__locked-browser-release"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "Unknown env browser command: ${command}" >&2
      env_usage >&2
      return 2
      ;;
  esac
}

env_usage() {
  cat <<EOF
Usage:
  buddyswitch-codex env status [--json]
  buddyswitch-codex env browser status [--instance <actor-id>] [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser ensure --instance <actor-id> [--port <port>] [--profile-dir <dir>]
  buddyswitch-codex env browser release --instance <actor-id>
  buddyswitch-codex env reset [--yes]
EOF
}

env_main() {
  local command="${1:-}"
  case "${command}" in
    status)
      shift || true
      env_status "$@"
      ;;
    browser)
      shift || true
      env_browser_main "$@"
      ;;
    reset)
      shift || true
      env_reset "$@"
      ;;
    help|-h|--help|"")
      env_usage
      ;;
    *)
      echo "env command is not available yet in this task stage." >&2
      env_usage >&2
      return 2
      ;;
  esac
}

legacy_command_hint() {
  local command="${1:-}"
  case "${command}" in
    start)
      echo "buddyswitch-codex instance start --role <role>"
      ;;
    role)
      echo "buddyswitch-codex instance roles"
      ;;
    cleanup)
      echo "buddyswitch-codex data cleanup ..."
      ;;
    reset)
      echo "buddyswitch-codex env reset --yes"
      ;;
    browser)
      echo "buddyswitch-codex env browser status|ensure ..."
      ;;
    workspace)
      echo "No public replacement. Use instance lifecycle commands."
      ;;
    *)
      echo "buddyswitch-codex help"
      ;;
  esac
}

fail_removed_public_command() {
  local command="${1:-}"
  local hint
  hint="$(legacy_command_hint "${command}")"
  echo "Top-level command removed: ${command}" >&2
  echo "Use: ${hint}" >&2
  return 2
}

fail_unknown_top_level_command() {
  local command="${1:-}"
  echo "Unknown top-level command: ${command}" >&2
  echo "Run: buddyswitch-codex help" >&2
  return 2
}

web_main() {
  buddyswitch_central_daemon_ensure || return $?
  local status
  if python3 "${WEB_MANAGEMENT_HELPER}" "$@"; then
    status=0
  else
    status=$?
  fi
  buddyswitch_central_daemon_stop_if_idle
  return "${status}"
}

main() {
  local command="${1:-}"
  case "${command}" in
    __locked-start-bootstrap)
      shift || true
      start_locked_bootstrap "$@"
      ;;
    __locked-reset)
      shift || true
      reset_shared_env_locked "$@"
      ;;
    __locked-browser-ensure)
      shift || true
      browser_ensure_locked "$@"
      ;;
    __locked-browser-release)
      shift || true
      browser_release_locked "$@"
      ;;
    __locked-instance-set-inactive)
      shift || true
      instance_set_inactive_locked "$@"
      ;;
    __locked-instance-resume)
      shift || true
      instance_resume_locked "$@"
      ;;
    __locked-instance-delete)
      shift || true
      instance_delete_locked "$@"
      ;;
    __locked-cleanup)
      shift || true
      buddyswitch_cleanup_run_locked "$@"
      ;;
    help|-h|--help)
      print_help
      ;;
    instance)
      shift || true
      buddyswitch_instance_main "$@"
      ;;
    web)
      shift || true
      web_main "$@"
      ;;
    data)
      shift || true
      data_main "$@"
      ;;
    env)
      shift || true
      env_main "$@"
      ;;
    start|role|cleanup|reset|browser|workspace)
      fail_removed_public_command "${command}"
      ;;
    "")
      echo "Missing BuddySwitch command." >&2
      echo "Run: buddyswitch-codex help" >&2
      return 2
      ;;
    *)
      fail_unknown_top_level_command "${command}"
      ;;
  esac
}

main "$@"
